# Mark machine-generated trees so GitHub collapses their diffs, excludes
# them from language stats, and reviewers aren't nagged by noise.
#
# See docs/devex/04-codegen-assessment.md and generated/README.md.

generated/**    linguist-generated=true
generated/**    -diff

# Lockfiles and test snapshots are not interesting to read in PRs.
pnpm-lock.yaml  linguist-generated=true
*.snap          linguist-generated=true

# Binary assets — never attempt a text diff.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.pdf           binary
*.sqlite3       binary

# Clean source exports should contain tracked source, not local state or native
# build outputs from a maintainer workstation.
.kuzushi/       export-ignore
.ralph/         export-ignore
.codex/         export-ignore
.codex-active/  export-ignore
.playwright-mcp/ export-ignore
.serena/        export-ignore
*.sqlite3       export-ignore
*.sqlite3-wal   export-ignore
*.sqlite3-shm   export-ignore
.tmp-*.md       export-ignore
kuzushi-*-prompt.md export-ignore
native/         export-ignore
target/         export-ignore
node_modules/   export-ignore
coverage/       export-ignore
# Preserve authenticated upstream bytes and its Markdown line endings.
third-party/crossterm/** -text whitespace=cr-at-eol
third-party/crossterm/**/*.md -text whitespace=cr-at-eol,-blank-at-eol
