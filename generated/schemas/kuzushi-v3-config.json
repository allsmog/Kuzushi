{
  "$comment": "Generated by `cargo xtask codegen` from crates/kuzushi-core V2Config — do not edit.",
  "$defs": {
    "AgentRuntimeSelector": {
      "description": "Which agent runtime backs tool-augmented model calls.\n\n`bridge` spawns the Node LangGraph bridge (`scripts/langgraph-bridge.mjs`)\nand is the default so existing installs are unchanged. `native` selects the\nin-process Rust runtime (`kuzushi-openai`'s `AnthropicOAuthRuntime`), the\nzero-Node path. Both ship during parity testing; the default flips to\n`native` only once golden-run parity is proven (see\n`docs/typescript-removal/STATUS.md`).",
      "enum": [
        "bridge",
        "native"
      ],
      "type": "string"
    },
    "AnthropicOauthConfig": {
      "additionalProperties": false,
      "properties": {
        "allow_env_token": {
          "default": false,
          "description": "If true, allow `ANTHROPIC_AUTH_TOKEN` / `ANTHROPIC_OAUTH_TOKEN` env vars\nas a fallback when the credentials file is absent. Default false —\noperators who declare OAuth expect the bag.",
          "type": "boolean"
        },
        "credentials_path": {
          "description": "Path to the OAuth credentials bag (default: `~/.kuzushi/oauth-credentials.json`).\nResolved relative to the home directory if not absolute.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "GuidedPhase": {
      "enum": [
        "map",
        "hunt",
        "confirm",
        "fix"
      ],
      "type": "string"
    },
    "GuidedPhaseConfig": {
      "additionalProperties": false,
      "properties": {
        "confirm": {
          "$ref": "#/$defs/PhaseTemplateConfig",
          "default": {}
        },
        "fix": {
          "$ref": "#/$defs/PhaseTemplateConfig",
          "default": {}
        },
        "hunt": {
          "$ref": "#/$defs/PhaseTemplateConfig",
          "default": {}
        },
        "map": {
          "$ref": "#/$defs/PhaseTemplateConfig",
          "default": {}
        },
        "stop_after": {
          "anyOf": [
            {
              "$ref": "#/$defs/GuidedPhase"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "OperatorConfig": {
      "additionalProperties": false,
      "properties": {
        "session_budget_usd": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "spend_hard_ceiling_usd": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "trusted_modules": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "trusted_workflow_auto_accept": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "PhaseTemplateConfig": {
      "additionalProperties": false,
      "properties": {
        "budget_usd": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "concurrency": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "confirmation_depth": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_variant": {
          "type": [
            "string",
            "null"
          ]
        },
        "strategy_cap": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "RuntimeConfig": {
      "additionalProperties": false,
      "properties": {
        "agent_runtime": {
          "$ref": "#/$defs/AgentRuntimeSelector",
          "description": "Agent-runtime backend selector (`bridge` | `native`). Defaults to\n`bridge`; skipped on serialize when default so existing config files\nround-trip unchanged."
        },
        "anthropic_oauth": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnthropicOauthConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "api_key_env": {
          "default": "OPENAI_API_KEY",
          "type": "string"
        },
        "base_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/RuntimeKind",
          "default": "lang-graph"
        },
        "langgraph_bridge_command": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "thinking_level": {
          "type": [
            "string",
            "null"
          ]
        },
        "worker_watchdog_timeout_ms": {
          "default": 21600000,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "RuntimeKind": {
      "enum": [
        "lang-graph"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "operator": {
      "$ref": "#/$defs/OperatorConfig",
      "default": {
        "trusted_workflow_auto_accept": false
      }
    },
    "phases": {
      "$ref": "#/$defs/GuidedPhaseConfig",
      "default": {
        "confirm": {},
        "fix": {},
        "hunt": {},
        "map": {}
      }
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeConfig",
      "default": {
        "api_key_env": "OPENAI_API_KEY",
        "kind": "lang-graph",
        "worker_watchdog_timeout_ms": 21600000
      }
    }
  },
  "title": "KuzushiV3Config",
  "type": "object"
}
