---
title: "Kuzushi - Current Rust Architecture"
---
flowchart LR
  %% Current as of 2026-05-05 after the Rust/LangGraph cutover.

  subgraph Entry["Entry points"]
    Npm["npm bin<br/>bin/kuzushi-rs.mjs"]
    CLI["Rust CLI<br/>crates/kuzushi-cli/src/main.rs"]
    ShellCmd["shell command<br/>kuzushi / kuzushi shell"]
    ScanCmd["scan command<br/>kuzushi scan"]
    RunCmd["run command<br/>kuzushi run"]
    ConfigCmd["config/modules/tools/findings<br/>native subcommands"]
  end

  subgraph Shell["Interactive shell mode"]
    TuiApp["Ratatui shell app<br/>crates/kuzushi-tui/src/app/"]
    Commands["Rust command parser<br/>crates/kuzushi-tui/src/commands/"]
    Renderer["Ratatui renderer<br/>crates/kuzushi-tui/src/renderer/"]
    ShellViews["Catalog, module, run,<br/>findings, threats, prompts"]
  end

  subgraph Core["Shared Rust core"]
    Registry["ModuleRegistry<br/>crates/kuzushi-core/src/modules/"]
    ToolCtx["ToolExecutionContext<br/>config, workspace, findings store"]
    Workspace["WorkspaceTarget<br/>crates/kuzushi-core/src/workspace.rs"]
    Findings["FindingStore<br/>crates/kuzushi-core/src/findings/"]
    ScanCore["ScanEngine trait and scan runner<br/>crates/kuzushi-core/src/scan/"]
  end

  subgraph Modules["Native module executors"]
    NativeTools["Deterministic Rust tools<br/>context, findings, secrets,<br/>dep hygiene, IaC, Chrome RCE"]
    SubprocessTools["Subprocess adapters<br/>semgrep, codeql, recon, curl/nmap"]
    AgenticTools["LangGraph tools<br/>triage, verify, patch,<br/>agentic SAST, threat-model,<br/>x-ray, variants, plugins"]
    HiddenDag["Hidden DAG/internal nodes<br/>context-lite, pipeline,<br/>systems-hunt internals"]
  end

  subgraph Runtime["Agent runtime"]
    RuntimeTrait["AgentRuntime trait<br/>crates/kuzushi-core/src/runtime.rs"]
    LangBridge["LangGraphRuntime<br/>crates/kuzushi-openai/src/lib.rs"]
    BridgeScript["Node bridge<br/>scripts/langgraph-bridge.mjs"]
    Provider["Configured provider/model<br/>explicit, no silent fallback"]
  end

  subgraph Storage["Persistence and artifacts"]
    Config["~/.kuzushi/v3/config.toml<br/>.kuzushi/v3/config.toml"]
    Db[".kuzushi/v3/index.sqlite3"]
    Runs[".kuzushi/v3/runs/&lt;runId&gt;/<br/>run.json, events.jsonl, items.jsonl"]
    Artifacts["context-snapshot.json<br/>threat-model.json<br/>x-ray/ and module artifacts"]
  end

  subgraph External["External dependencies"]
    Repo["Target repository"]
    Semgrep["semgrep"]
    Codeql["CodeQL CLI"]
    NetTools["curl / nmap / git"]
    Plugins["Optional plugin roots"]
    ProviderApis["Provider APIs or local endpoints"]
  end

  Npm --> CLI
  CLI --> ShellCmd
  CLI --> ScanCmd
  CLI --> RunCmd
  CLI --> ConfigCmd

  ShellCmd --> TuiApp
  TuiApp --> Commands
  TuiApp --> Renderer
  Renderer --> ShellViews
  TuiApp --> Registry

  ScanCmd --> Registry
  ScanCmd --> ScanCore
  RunCmd --> Registry
  ConfigCmd --> Registry
  ConfigCmd --> Findings

  Registry --> ToolCtx
  ToolCtx --> Workspace
  ToolCtx --> Findings
  Registry --> NativeTools
  Registry --> SubprocessTools
  Registry --> AgenticTools
  Registry --> HiddenDag
  ScanCore --> SubprocessTools
  ScanCore --> NativeTools

  AgenticTools --> RuntimeTrait
  RuntimeTrait --> PiBridge
  PiBridge --> BridgeScript
  BridgeScript --> Provider

  Workspace --> Config
  Findings --> Db
  ScanCore --> Runs
  NativeTools --> Artifacts
  AgenticTools --> Artifacts

  NativeTools --> Repo
  SubprocessTools --> Repo
  SubprocessTools --> Semgrep
  SubprocessTools --> Codeql
  SubprocessTools --> NetTools
  AgenticTools --> Plugins
  Provider --> ProviderApis

