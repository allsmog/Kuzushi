{
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@5",
      "memory": 1024,
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/v1/runs", "destination": "/api/runs" },
    { "source": "/v1/runs/:id", "destination": "/api/runs/:id" },
    { "source": "/v1/runs/:id/status", "destination": "/api/runs/:id/status" },
    { "source": "/v1/runs/:id/output", "destination": "/api/runs/:id/output" }
  ]
}
