{
  "name": "kuzushi",
  "version": "0.24.0-alpha.12",
  "description": "Kuzushi — security-native code agent for evidence-backed repository scans",
  "author": "Shayaun Nejad",
  "repository": {
    "type": "git",
    "url": "https://github.com/allsmog/Kuzushi.git"
  },
  "homepage": "https://github.com/allsmog/Kuzushi",
  "bugs": {
    "url": "https://github.com/allsmog/Kuzushi/issues"
  },
  "type": "module",
  "exports": {
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "kuzushi": "./bin/kuzushi-rs.mjs",
    "kz": "./bin/kuzushi-rs.mjs"
  },
  "scripts": {
    "setup": "bash scripts/bootstrap.sh",
    "doctor": "bash scripts/doctor.sh",
    "check:docs": "node scripts/check-release-contract.mjs && node scripts/check-port-contract.mjs && node scripts/check-public-identity.mjs && node scripts/check-doc-command-drift.mjs && node scripts/check-codeql-mcp-latency-contract.mjs && node scripts/check-retired-ts-runtime.mjs",
    "check:release": "node scripts/check-release-contract.mjs",
    "release:bump": "node scripts/bump-release-version.mjs",
    "check:retired-ts-runtime": "node scripts/check-retired-ts-runtime.mjs",
    "export:source": "bash scripts/export-clean-source.sh",
    "setup:benchmarks": "bash scripts/setup-benchmarks.sh",
    "prepare": "husky",
    "launch": "cargo run -p kuzushi-cli -- --target . shell",
    "dev": "cargo run -p kuzushi-cli",
    "dev:rust": "cargo run -p kuzushi-cli",
    "link:local": "node scripts/link-local.mjs",
    "link:local:restore": "node scripts/link-local.mjs --restore",
    "build:rust": "cargo build --workspace --locked",
    "build:native": "node scripts/build-native-runtime.mjs",
    "prepack": "pnpm build:native",
    "test": "node --test scripts/setup-contract.test.mjs scripts/ensure-upstream-remote.test.mjs scripts/bump-release-version.test.mjs scripts/rust-mutation-shard.test.mjs scripts/rust-source-markers.test.mjs scripts/verify-repository.test.mjs scripts/check-secrets.test.mjs scripts/recall-eval-score.test.mjs scripts/smoke-published-release.test.mjs scripts/check-diff-coverage.test.mjs scripts/langgraph-bridge/errors.test.mjs scripts/langgraph-bridge/file-tools.test.mjs scripts/langgraph-bridge/mcp.test.mjs scripts/langgraph-bridge/model.test.mjs scripts/langgraph-bridge/oauth-login.test.mjs",
    "test:rust": "cargo test --workspace --locked",
    "test:performance": "cargo test -p kuzushi-tui --lib workbench_warmed_input_to_paint_p95_stays_within_budget --locked -- --ignored --test-threads=1",
    "test:e2e": "bash tests/e2e/run-smoke.sh",
    "test:coverage:node": "node --experimental-test-coverage --test --test-coverage-include=scripts/langgraph-bridge/mcp.mjs --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=85 scripts/langgraph-bridge/mcp.test.mjs && node --experimental-test-coverage --test --test-coverage-include=scripts/langgraph-bridge/oauth-login.mjs --test-coverage-lines=55 --test-coverage-functions=50 --test-coverage-branches=85 scripts/langgraph-bridge/oauth-login.test.mjs",
    "test:coverage:rust": "bash scripts/run-rust-coverage.sh",
    "test:coverage": "pnpm test:coverage:node && pnpm test:coverage:rust",
    "test:mutations": "bash scripts/run-rust-mutations.sh",
    "quality:crap-risk": "node --test scripts/crap-risk-test-mapping.test.mjs scripts/crap-risk-gate.test.mjs && node scripts/crap-risk-gate.mjs",
    "quality:identity": "node scripts/check-public-identity.mjs",
    "quality:architecture": "node scripts/check-ddd-boundaries.mjs && node scripts/check-ddd-context-docs.mjs && node scripts/check-artifact-contract.mjs && node scripts/check-result-envelope-contract.mjs && node scripts/check-retired-ts-runtime.mjs && node scripts/check-deferred-surface-contract.mjs && node scripts/check-env-discipline.mjs && node scripts/check-dispatch-boundary-contract.mjs && node scripts/check-run-lifecycle-boundary.mjs && node scripts/check-workspace-state-writes.mjs && node scripts/check-validated-wording.mjs",
    "check:workspace-state-writes": "node scripts/check-workspace-state-writes.mjs",
    "quality:model-safety": "node scripts/check-model-safety.mjs",
    "quality:secrets": "node scripts/check-secrets.mjs",
    "verify:quick": "node scripts/verify-repository.mjs quick",
    "verify:quick:summary": "node scripts/verify-repository.mjs quick --summary",
    "verify:ci": "node scripts/verify-repository.mjs ci",
    "verify:ci:summary": "node scripts/verify-repository.mjs ci --summary",
    "verify:pack": "node scripts/verify-pack.mjs && node scripts/smoke-packed-runtime.mjs",
    "publish:npm": "bash scripts/publish-npm.sh",
    "publish:npm:dry": "bash scripts/publish-npm.sh",
    "publish:npm:go": "bash scripts/publish-npm.sh --publish",
    "lint": "biome lint .",
    "format": "biome format .",
    "check": "biome check --error-on-warnings .",
    "fix": "biome check --write .",
    "fix:unsafe": "biome check --write --unsafe ."
  },
  "files": [
    "bin",
    "native",
    "scripts/langgraph-bridge.mjs",
    "scripts/langgraph-bridge",
    "scripts/kuzushi-dynamic-module-host.mjs",
    "schemas",
    "examples/kwp/agentic-fuzz",
    "assets/pashov-xray",
    "README.md",
    "UPSTREAM_CODEX.md",
    "NOTICE",
    "LICENSES",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/vertex-sdk": "^0.19.0",
    "@langchain/anthropic": "^1.0.0",
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/mcp-adapters": "^1.0.0",
    "@langchain/openai": "^1.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@cfworker/json-schema": "^4.1.1",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "chalk": "^6.0.0",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "ws@>=8.0.0 <8.21.0": ">=8.21.0"
    }
  },
  "keywords": [
    "sast",
    "security",
    "semgrep",
    "ai",
    "triage"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.30.0+sha512.2b5753de015d480eeb88f5b5b61e0051f05b4301808a82ec8b840c9d2adf7748eb352c83f5c1593ca703ff1017295bc3fdd3119abb9686efc96b9fcb18200937"
}
