{
  "name": "kuzushi",
  "version": "0.24.0-alpha.8",
  "description": "Kuzushi \u2014 security-native code agent for evidence-backed repository scans",
  "author": "Shayaun Nejad",
  "repository": {
    "type": "git",
    "url": "https://github.com/allsmog/Kuzushi.git"
  },
  "homepage": "https://github.com/allsmog/Kuzushi",
  "bugs": {
    "url": "https://github.com/allsmog/Kuzushi/issues"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./modules": {
      "types": "./dist/modules/index.d.ts",
      "default": "./dist/modules/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "kuzushi": "./bin/kuzushi-rs.mjs",
    "kz": "./bin/kuzushi-rs.mjs"
  },
  "scripts": {
    "setup": "bash scripts/bootstrap.sh",
    "doctor": "bash scripts/doctor.sh",
    "check:docs": "node scripts/check-release-contract.mjs && node scripts/check-port-contract.mjs && node scripts/check-public-identity.mjs && node scripts/check-doc-command-drift.mjs && node scripts/check-codeql-mcp-latency-contract.mjs && node scripts/check-retired-ts-runtime.mjs",
    "check:release": "node scripts/check-release-contract.mjs",
    "release:bump": "node scripts/bump-release-version.mjs",
    "verify:quick": "node scripts/verify-repository.mjs quick",
    "verify:ci": "node scripts/verify-repository.mjs ci",
    "check:retired-ts-runtime": "node scripts/check-retired-ts-runtime.mjs",
    "export:source": "bash scripts/export-clean-source.sh",
    "setup:benchmarks": "bash scripts/setup-benchmarks.sh",
    "prepare": "husky",
    "dev": "cargo run -p kuzushi-cli",
    "dev:rust": "cargo run -p kuzushi-cli",
    "link:local": "node scripts/link-local.mjs",
    "link:local:restore": "node scripts/link-local.mjs --restore",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "build:rust": "cargo build --workspace",
    "build:native": "node scripts/build-native-runtime.mjs",
    "build:clean": "pnpm clean:dist && tsc",
    "prepack": "pnpm build:clean && pnpm build:native",
    "check:types": "node scripts/typecheck-all.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "node scripts/typecheck-all.mjs",
    "typecheck:benchmarks": "tsc -p benchmarks/tsconfig.json --noEmit",
    "typecheck:perf": "tsc -p perf/tsconfig.json --noEmit",
    "test": "vitest run && node --test benchmarks/regression-check.test.mjs scripts/typecheck-all.test.mjs scripts/setup-contract.test.mjs scripts/bump-release-version.test.mjs scripts/verify-repository.test.mjs",
    "test:rust": "cargo test --workspace",
    "test:e2e": "bash tests/e2e/run-smoke.sh",
    "test:coverage": "vitest run --coverage && node --test benchmarks/regression-check.test.mjs scripts/typecheck-all.test.mjs scripts/setup-contract.test.mjs scripts/bump-release-version.test.mjs scripts/verify-repository.test.mjs",
    "quality:crap-risk": "node --test scripts/crap-risk-test-mapping.test.mjs scripts/crap-risk-gate.test.mjs && node scripts/crap-risk-gate.mjs",
    "quality:identity": "node scripts/check-public-identity.mjs",
    "quality:architecture": "node scripts/check-ddd-boundaries.mjs && node scripts/check-ddd-context-docs.mjs && node scripts/check-artifact-contract.mjs && node scripts/check-result-envelope-contract.mjs && node scripts/check-retired-ts-runtime.mjs && node scripts/check-deferred-surface-contract.mjs && node scripts/check-env-discipline.mjs && node scripts/check-dispatch-boundary-contract.mjs && node scripts/check-run-lifecycle-boundary.mjs && node scripts/check-workspace-state-writes.mjs && node scripts/check-validated-wording.mjs",
    "check:workspace-state-writes": "node scripts/check-workspace-state-writes.mjs",
    "quality:model-safety": "node scripts/check-model-safety.mjs",
    "verify:pack": "node scripts/verify-pack.mjs && node scripts/smoke-packed-runtime.mjs",
    "publish:npm": "bash scripts/publish-npm.sh",
    "publish:npm:dry": "bash scripts/publish-npm.sh",
    "publish:npm:go": "bash scripts/publish-npm.sh --publish",
    "benchmark": "tsx benchmarks/harness.ts",
    "benchmark:freeze": "tsx benchmarks/freeze-baseline.ts",
    "benchmark:diff": "tsx benchmarks/sarif-diff.ts",
    "benchmark:regression": "tsx benchmarks/regression-check.ts",
    "benchmark:regression:test": "node --test benchmarks/regression-check.test.mjs",
    "benchmark:scoreboard": "tsx benchmarks/scoreboard.ts",
    "eval:kuzushi-whitebox-static": "node --import tsx evals/kuzushi-whitebox-static/run.ts",
    "perf": "tsx perf/harness.ts",
    "check:circular": "madge --ts-config tsconfig.json --extensions ts --circular src/",
    "complexity": "node scripts/cyclomatic.mjs src --top 30 --min 20",
    "complexity:logic": "node scripts/cyclomatic.mjs src --top 30 --min 20 --logic-only",
    "codegen": "tsx scripts/codegen/index.ts",
    "codegen:check": "tsx scripts/codegen/check.ts",
    "typecheck:codegen": "tsc -p scripts/codegen/tsconfig.json --noEmit",
    "lint": "biome lint .",
    "format": "biome format .",
    "check": "biome check .",
    "fix": "biome check --write .",
    "fix:unsafe": "biome check --write --unsafe ."
  },
  "files": [
    "dist",
    "!dist/cli",
    "!dist/cli.d.ts",
    "!dist/cli.js",
    "!dist/cli.js.map",
    "bin",
    "native",
    "scripts/langgraph-bridge.mjs",
    "scripts/langgraph-bridge",
    "scripts/kuzushi-dynamic-module-host.mjs",
    "schemas",
    "examples/kwp/agentic-fuzz",
    "assets/pashov-xray",
    "README.md",
    "UPSTREAM_CODEX.md",
    "NOTICE",
    "LICENSES",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.0.0",
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/mcp-adapters": "^1.0.0",
    "@langchain/openai": "^1.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@cfworker/json-schema": "^4.1.1",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^22.13.4",
    "@vitest/coverage-v8": "^3.2.7",
    "chalk": "^5.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "madge": "^8.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "ws@>=8.0.0 <8.21.0": ">=8.21.0"
    }
  },
  "keywords": [
    "sast",
    "security",
    "semgrep",
    "ai",
    "triage"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.30.0+sha512.2b5753de015d480eeb88f5b5b61e0051f05b4301808a82ec8b840c9d2adf7748eb352c83f5c1593ca703ff1017295bc3fdd3119abb9686efc96b9fcb18200937"
}
