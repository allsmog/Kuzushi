{
  "name": "kuzushi",
  "version": "0.19.2",
  "description": "Kuzushi — security-native AI operating environment",
  "author": "Shayaun Nejad",
  "repository": {
    "type": "git",
    "url": "https://github.com/allsmog/Kuzushi.git"
  },
  "homepage": "https://github.com/allsmog/Kuzushi",
  "bugs": {
    "url": "https://github.com/allsmog/Kuzushi/issues"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./modules": {
      "types": "./dist/modules/index.d.ts",
      "default": "./dist/modules/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "kuzushi": "./dist/cli.js"
  },
  "scripts": {
    "setup": "bash scripts/bootstrap.sh",
    "doctor": "bash scripts/doctor.sh",
    "setup:benchmarks": "bash scripts/setup-benchmarks.sh",
    "prepare": "husky",
    "dev": "tsx src/cli.ts",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "build:clean": "pnpm clean:dist && tsc",
    "prepack": "pnpm build:clean",
    "check:types": "node scripts/typecheck-all.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "node scripts/typecheck-all.mjs",
    "typecheck:benchmarks": "tsc -p benchmarks/tsconfig.json --noEmit",
    "typecheck:perf": "tsc -p perf/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "bash tests/e2e/run-smoke.sh",
    "test:coverage": "vitest run --coverage",
    "verify:pack": "npm pack --dry-run",
    "publish:npm": "bash scripts/publish-npm.sh",
    "publish:npm:dry": "bash scripts/publish-npm.sh",
    "publish:npm:go": "bash scripts/publish-npm.sh --publish",
    "benchmark": "tsx benchmarks/harness.ts",
    "benchmark:freeze": "tsx benchmarks/freeze-baseline.ts",
    "benchmark:diff": "tsx benchmarks/sarif-diff.ts",
    "benchmark:regression": "tsx benchmarks/regression-check.ts",
    "perf": "tsx perf/harness.ts",
    "check:circular": "madge --ts-config tsconfig.json --extensions ts,tsx --circular src/",
    "complexity": "node scripts/cyclomatic.mjs src --top 30 --min 20",
    "complexity:logic": "node scripts/cyclomatic.mjs src --top 30 --min 20 --logic-only",
    "codegen": "tsx scripts/codegen/index.ts",
    "codegen:check": "tsx scripts/codegen/check.ts",
    "typecheck:codegen": "tsc -p scripts/codegen/tsconfig.json --noEmit",
    "lint": "biome lint .",
    "format": "biome format .",
    "check": "biome check .",
    "fix": "biome check --write .",
    "fix:unsafe": "biome check --write --unsafe ."
  },
  "files": [
    "dist",
    "assets/ascii",
    "assets/sounds",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.87",
    "@anthropic-ai/sdk": "^0.81.0",
    "@kuzushi/augur": "^0.1.0",
    "@kuzushi/randori-plugin": "github:allsmog/randori-plugin",
    "@kuzushi/tob-skills": "github:allsmog/tob-security-skills",
    "@kuzushi/vuln-scout": "github:allsmog/vuln-scout",
    "@mariozechner/pi-ai": "^0.68.0",
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ink": "^5",
    "promptarmor-plugin": "github:allsmog/promptarmor-plugin",
    "react": "^18",
    "shinsa-plugin": "github:allsmog/shinsa-plugin",
    "tinyglobby": "^0.2.15",
    "typescript": "^5.7.3",
    "undici": "^7.22.0",
    "yaml": "^2.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.4",
    "@types/react": "^18",
    "@vitest/coverage-v8": "^3.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "madge": "^8.0.0",
    "tsx": "^4.19.2",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "keywords": [
    "sast",
    "security",
    "semgrep",
    "ai",
    "triage"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.30.0+sha512.2b5753de015d480eeb88f5b5b61e0051f05b4301808a82ec8b840c9d2adf7748eb352c83f5c1593ca703ff1017295bc3fdd3119abb9686efc96b9fcb18200937"
}
