{
  "name": "kuzushi",
  "version": "0.1.0",
  "private": true,
  "description": "Kuzushi — Agentic SAST scanner with AI triage",
  "type": "module",
  "bin": {
    "kuzushi": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "benchmark": "tsx benchmarks/harness.ts",
    "benchmark:diff": "tsx benchmarks/sarif-diff.ts",
    "benchmark:regression": "tsx benchmarks/regression-check.ts",
    "typecheck:benchmarks": "tsc -p benchmarks/tsconfig.json --noEmit"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.52",
    "@kuzushi/augur": "^0.1.0",
    "@mariozechner/pi-ai": "^0.57.1",
    "better-sqlite3": "^11.8.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.4",
    "@vitest/coverage-v8": "^3.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "keywords": [
    "sast",
    "security",
    "semgrep",
    "ai",
    "triage"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.30.0+sha512.2b5753de015d480eeb88f5b5b61e0051f05b4301808a82ec8b840c9d2adf7748eb352c83f5c1593ca703ff1017295bc3fdd3119abb9686efc96b9fcb18200937"
}
