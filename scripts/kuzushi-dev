#!/usr/bin/env bash
# Run kuzushi from source via tsx — useful during development when
# `dist/cli.js` is stale or missing. Invokes the same argv as the
# published binary. Field-test issue #56.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

exec node --import tsx "${REPO_ROOT}/src/cli.ts" "$@"
