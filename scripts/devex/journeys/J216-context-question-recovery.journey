name: Read-only recovery and Back ownership for a completed context question
size: 120x36
cwd: @TARGET
env-unset: NODE_OPTIONS KUZUSHI_LANGGRAPH_BRIDGE ANTHROPIC_API_KEY OPENAI_API_KEY KUZUSHI_MODEL
env: HOME=@TARGET/../home KUZUSHI_SKIP_ONBOARDING=1 KUZUSHI_REDUCED_MOTION=1 NO_COLOR=1
require-shell: python3 -B @REPO/scripts/devex/fixtures/context_question.py @TARGET @ART recover
require-wrapper-flow:
launch: --target @TARGET
require-live-snap: 30 KUZUSHI | ready
paste-file: @ART/resume-command.txt
keys: Enter
require-live-snap: 25 a context result | recovered-jobs
nav-mode:
keys: a
require-live-snap: 25 Read question answer | recovered-plan
expect: 1 committed / 2 total
expect: 1 protected review
keys: Enter
require-live-snap: 25 CONTEXT ANSWER | recovered-answer
expect: Labeled synthetic answer
resize: 160x48
require-live-snap: 20 CONTEXT ANSWER | answer-160x48
resize: 96x89
require-live-snap: 20 CONTEXT ANSWER | answer-96x89
resize: 80x24
require-live-snap: 20 CONTEXT ANSWER | answer-80x24
resize: 60x20
require-live-snap: 20 CONTEXT ANSWER | answer-60x20
resize: 40x12
require-live-snap: 20 CONTEXT ANSWER | answer-40x12
keys: NPage NPage NPage
require-live-snap: 20 Model: | compact-receipt
resize: 120x36
keys: Escape
require-live-snap: 20 ASK ABOUT CONTEXT | back-plan
keys: Escape
require-live-snap: 20 a context result | back-jobs
require-shell: python3 -B @REPO/scripts/devex/fixtures/context_question.py @TARGET @ART recover
ask: Does Back return from the same saved answer to its plan and job deck without another request or a changed context?
keys: C-c
require-exit: 10
