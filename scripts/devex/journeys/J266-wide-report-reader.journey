resize: 160x48
require-live-snap: 15 format jsonl (3/6) | jsonl-160x48
expect: findings.jsonl
resize: 120x36
require-live-snap: 15 format jsonl (3/6) | jsonl-120x36
expect: findings.jsonl
resize: 96x89
