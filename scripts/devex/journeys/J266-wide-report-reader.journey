name: Every report format and destination remain visible over an actual completed wide study
size: 120x36
cwd: @TARGET
env-unset: ANTHROPIC_API_KEY OPENAI_API_KEY KUZUSHI_MODEL KUZUSHI_LANGGRAPH_BRIDGE NODE_OPTIONS NO_COLOR
env: HOME=@TARGET/../home KUZUSHI_SKIP_ONBOARDING=1 KUZUSHI_REDUCED_MOTION=1
require-shell: python3 -B @REPO/scripts/devex/fixtures/wide_report.py @TARGET @ART seed
require-wrapper-flow:
launch: --target @TARGET
require-live-snap: 30 KUZUSHI | ready
paste-file: @ART/resume-command.txt
keys: Enter
require-live-snap: 25 24 completed | recorded-work
submit: report
require-live-snap: 25 9 findings · 9 reviewed | recorded-report
resize: 160x48
require-live-snap: 15 format json (4/6) | json-160x48
expect: findings.json
resize: 120x36
require-live-snap: 15 format json (4/6) | json-120x36
expect: findings.json
resize: 96x89
require-live-snap: 15 format json (4/6) | json-96x89
expect: findings.json
resize: 80x24
require-live-snap: 15 format json (4/6) | json-80x24
expect: findings.json
resize: 60x20
require-live-snap: 15 format json (4/6) | json-60x20
expect: findings.json
resize: 40x12
require-live-snap: 15 format json (4/6) | json-40x12
expect: findings.json
keys: PageDown
require-live-snap: 15 format json (4/6) | json-paged-40x12
expect: findings.json
keys: PageUp j
resize: 160x48
require-live-snap: 15 format csv (5/6) | csv-160x48
expect: findings.csv
resize: 120x36
require-live-snap: 15 format csv (5/6) | csv-120x36
expect: findings.csv
resize: 96x89
require-live-snap: 15 format csv (5/6) | csv-96x89
expect: findings.csv
resize: 80x24
require-live-snap: 15 format csv (5/6) | csv-80x24
expect: findings.csv
resize: 60x20
require-live-snap: 15 format csv (5/6) | csv-60x20
expect: findings.csv
resize: 40x12
require-live-snap: 15 format csv (5/6) | csv-40x12
expect: findings.csv
keys: PageDown
require-live-snap: 15 format csv (5/6) | csv-paged-40x12
expect: findings.csv
keys: PageUp j
resize: 160x48
require-live-snap: 15 format vuln-findings (6/6) | vuln-findings-160x48
expect: VULN-FINDINGS.json
resize: 120x36
require-live-snap: 15 format vuln-findings (6/6) | vuln-findings-120x36
expect: VULN-FINDINGS.json
resize: 96x89
