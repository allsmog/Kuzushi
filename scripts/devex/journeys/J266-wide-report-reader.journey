expect: report.sarif
keys: PageDown
require-live-snap: 15 format sarif (1/6) | sarif-paged-40x12
expect: report.sarif
keys: PageUp j
resize: 160x48
require-live-snap: 15 format markdown-bundle (2/6) | markdown-bundle-160x48
expect: report/
