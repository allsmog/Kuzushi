expect: VULN-FINDINGS.json
resize: 40x12
require-live-snap: 15 format vuln-findings (6/6) | vuln-findings-40x12
expect: VULN-FINDINGS.json
keys: PageDown
require-live-snap: 15 format vuln-findings (6/6) | vuln-findings-paged-40x12
expect: VULN-FINDINGS.json
keys: PageUp k k k k k
resize: 160x48
require-live-snap: 15 format sarif (1/6) | sarif-160x48
expect: report.sarif
resize: 120x36
require-live-snap: 15 format sarif (1/6) | sarif-120x36
expect: report.sarif
resize: 96x89
require-live-snap: 15 format sarif (1/6) | sarif-96x89
expect: report.sarif
resize: 80x24
