expect: no active work
keys: y
require-exit: 10
env-unset: ANTHROPIC_API_KEY OPENAI_API_KEY NODE_OPTIONS NO_COLOR KUZUSHI_MODEL KUZUSHI_LANGGRAPH_BRIDGE KUZUSHI_SKIP_ONBOARDING
env: HOME=@TMP_HOME KUZUSHI_REDUCED_MOTION=1 NO_COLOR=1 KUZUSHI_SKIP_ONBOARDING=1
launch: --target @TMP_TARGET
require-live-snap: 30 KUZUSHI | restarted
submit: workbench
require-shell: python3 -B @REPO/scripts/devex/fixtures/investigation_footer.py @TMP_TARGET @ART 5/7 workbench
require-live-snap: 25 calls 5/7 | recovered-workbench-120x36
resize: 40x12
require-shell: python3 -B @REPO/scripts/devex/fixtures/investigation_footer.py @TMP_TARGET @ART 5/7 workbench
require-live-snap: 20 calls 5/7 | recovered-workbench-40x12
resize: 120x36
submit: report
require-shell: python3 -B @REPO/scripts/devex/fixtures/investigation_footer.py @TMP_TARGET @ART 5/7 report
require-live-snap: 25 5 committed / 7 calls | recovered-report
expect: 1 canceled
expect-not: outcome unavailable
expect: 0 pending · TP: 0 · FP: 1 · 1 deferred
require-shell: python3 -B @REPO/scripts/devex/fixtures/investigation_cancellation.py @TMP_TARGET @ART restart
require-shell: python3 -B @REPO/scripts/devex/fixtures/report_bundle.py @TMP_TARGET @ART restart
ask: Does no-color restart recover the accepted context, completed original jobs, both human decisions and shared consumption without another request or new investigation?
require-shell: python3 -B @REPO/scripts/devex/fixtures/investigation_cancellation.py @TMP_TARGET @ART hide-context
paste-file: @ART/context-command.txt
keys: Enter
require-live-snap: 25 Jobs: 3 | recorded-context-jobs-after-loss
nav-mode:
keys: a
require-live-snap: 25 Enter outcome | missing-context-result
expect: Context result unavailable
expect: no immutable context manifest
resize: 80x24
live-snap: missing-context-result-80x24
resize: 40x12
require-live-snap: 20 Inspect context job outcome | missing-context-result-40x12
expect: Enter outcome
expect-not: Owned greeting application
ask: Does a missing owned-fixture manifest produce an honest outcome view, retain inspection/back controls at 40x12, and avoid substituting another context or starting work?
require-shell: python3 -B @REPO/scripts/devex/fixtures/investigation_cancellation.py @TMP_TARGET @ART restore-context
keys: C-c
require-exit: 10
