resize: 96x89
live-snap: failure-96x89
resize: 80x24
live-snap: failure-80x24
resize: 60x20
live-snap: failure-60x20
resize: 40x12
live-snap: failure-40x12
expect: Enter inspect
keys: NPage NPage NPage NPage NPage NPage NPage NPage
live-snap: failure-tail-40x12
ask: Across six sizes, can the operator read the failure and visible next actions while the exhausted allowance and inactive architecture remain unchanged?
require-shell: python3 -B @REPO/scripts/devex/fixtures/scope_proposal_failure.py @ART inspected
resize: 120x36
keys: C-c
require-exit: 10
env: HOME=@REPO/scripts/devex/artifacts/monorepo-scope-live-20261025/attempt-2/operator-home KUZUSHI_SKIP_ONBOARDING=1 KUZUSHI_REDUCED_MOTION=1 NO_COLOR=1 NODE_OPTIONS=--import=@REPO/scripts/devex/fixtures/deny_provider_transport.mjs KUZUSHI_TEST_DENIED_FETCH_LOG=@ART/denied-fetch.jsonl
launch: --target @REPO/scripts/devex/artifacts/monorepo-scope-live-20261025/attempt-2/target
