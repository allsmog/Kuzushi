name: Report source history survives exports and format tradeoffs remain visible
size: 120x36
cwd: @TARGET
env-unset: NODE_OPTIONS KUZUSHI_LANGGRAPH_BRIDGE ANTHROPIC_API_KEY OPENAI_API_KEY KUZUSHI_MODEL NO_COLOR
env: HOME=/private/tmp/kuzushi-live-owned-investigation-20261010/home KUZUSHI_SKIP_ONBOARDING=1 KUZUSHI_REDUCED_MOTION=1
require-shell: python3 -B @REPO/scripts/devex/fixtures/report_source_history.py @TARGET @ART exports
require-wrapper-flow:
launch: --target @TARGET
submit: report
require-live-snap: 30 Scope: study live-owned-scans-20261010 | study-report
expect: 4 committed / 11 calls
expect: 2 protected review remaining
keys: End
require-live-snap: 20 Recorded source summaries: included | included-history
resize: 160x48
keys: End
live-snap: report-history-160x48
resize: 96x89
keys: End
live-snap: report-history-96x89
resize: 80x24
keys: End
live-snap: report-history-80x24
resize: 60x20
keys: End
live-snap: report-history-60x20
resize: 40x12
keys: End
live-snap: report-history-40x12
keys: PPage
live-snap: report-history-40x12-page-1
keys: PPage
live-snap: report-history-40x12-page-2
keys: PPage
live-snap: report-history-40x12-page-3
resize: 120x36
keys: Down
keys: End
require-live-snap: 20 Recorded source summaries: omitted | csv-omits-history
ask: Does Report make source-history preservation and CSV loss visible before export, without confusing recurrence with independent corroboration?
keys: Up
keys: End
require-live-snap: 20 Recorded source summaries: included | restored-format
require-shell: python3 -B @REPO/scripts/devex/fixtures/report_source_history.py @TARGET @ART verify
keys: C-c
require-exit: 10
env: HOME=/private/tmp/kuzushi-live-owned-investigation-20261010/home KUZUSHI_SKIP_ONBOARDING=1 KUZUSHI_REDUCED_MOTION=1 NO_COLOR=1
launch: --target @TARGET
submit: report
require-live-snap: 30 Scope: study live-owned-scans-20261010 | restarted-report
keys: End
require-live-snap: 20 Recorded source summaries: included | restarted-format
require-shell: python3 -B @REPO/scripts/devex/fixtures/report_source_history.py @TARGET @ART verify
keys: C-c
require-exit: 10
