name: Choose finite supporting files, preserve drafts and inspect frozen source without spending
size: 120x36
cwd: @TMP_TARGET
require-env: KUZUSHI_REVIEW_TEST_BIN
env-unset: ANTHROPIC_API_KEY OPENAI_API_KEY OPENROUTER_API_KEY GEMINI_API_KEY KUZUSHI_MODEL KUZUSHI_LANGGRAPH_BRIDGE KUZUSHI_AGENT_MCPS NODE_OPTIONS NO_COLOR
env: HOME=@TMP_HOME KUZUSHI_SKIP_ONBOARDING=1 KUZUSHI_REDUCED_MOTION=1
require-shell: python3 -B @REPO/scripts/devex/fixtures/review_supporting_files.py @TMP_TARGET @ART @TMP_HOME seed
require-wrapper-flow:
launch: --target @TMP_TARGET
require-live-snap: 30 KUZUSHI | ready
submit: plan review
require-live-snap: 25 Triage findings | review-picker
keys: Space Enter
require-live-snap: 25 PLAN FINDING REVIEW | review-plan
keys: s s c e f
require-live-snap: 25 REVIEW SUPPORTING FILES | file-picker
type: service.txt
keys: Space
require-live-snap: 20 1/16 chosen | first-choice
keys: C-u
type: store.txt
keys: Space
require-live-snap: 20 Repository · 2/16 chosen | second-choice
keys: Tab
require-live-snap: 20 Basket · 2/16 chosen | selected-basket
expect: 2/16 chosen
expect: service.txt
expect: store.txt
keys: Enter
require-live-snap: 20 Supporting files: 2 chosen | applied-choices
keys: t
keys: C-u
type: 5
keys: Enter
require-live-snap: 20 Total calls: 5 | drafted-total
keys: r
keys: C-u
type: 2
keys: Enter
require-live-snap: 20 protected Review: 2 | drafted-review
keys: f
require-live-snap: 20 REVIEW SUPPORTING FILES | reopened-picker
type: policy.txt
keys: Space
require-live-snap: 20 3/16 chosen | temporary-choice
keys: Escape
require-live-snap: 20 Supporting files: 2 chosen | canceled-choices
keys: f Tab
require-live-snap: 20 Basket | preserved-basket
resize: 160x48
live-snap: picker-160x48
resize: 96x89
live-snap: picker-96x89
resize: 80x24
live-snap: picker-80x24
resize: 60x20
live-snap: picker-60x20
resize: 40x12
require-live-snap: 20 REVIEW SUPPORTING FILES | picker-40x12
expect: Space toggle
expect: Enter apply
expect: Esc cancel
ask: Are the file list, capture order, selection basket and Apply/Cancel controls clear at every size, with choices preserved after cancel?
resize: 120x36
keys: Enter Enter
require-live-snap: 35 Cited source: 1/1 primary files | frozen-source
expect: Supporting files: 2/2 captured
require-shell: python3 -B @REPO/scripts/devex/fixtures/review_supporting_files.py @TMP_TARGET @ART @TMP_HOME prepared
keys: f
require-live-snap: 20 REVIEW SUPPORTING FILES | frozen-picker
type: policy.txt
keys: Space Escape
require-live-snap: 20 Supporting files: 2/2 captured | frozen-cancel
keys: f Enter
require-live-snap: 20 Supporting files: 2/2 captured | unchanged-apply
keys: v End
require-live-snap: 20 STORE_INPUT | supplied-supporting-code
expect: SERVICE_INPUT
expect-not: POLICY_INPUT
keys: Enter n s e c M t r
require-live-snap: 20 STORE_INPUT | reader-owns-input
expect: SERVICE_INPUT
expect: v plan
require-shell: python3 -B @REPO/scripts/devex/fixtures/review_supporting_files.py @TMP_TARGET @ART @TMP_HOME reader-input
ask: Does the reader show exactly the selected code while keeping Enter and hidden planner shortcuts from approving or changing the draft?
keys: Escape
require-live-snap: 20 LEAVE UNSAVED STUDY | unsaved-limit-choices
keys: d
require-live-snap: 20 Triage findings | returned-picker
keys: C-c
require-live-snap: 15 CONFIRM SESSION EXIT | exit-choices
keys: y
require-exit: 10
env: HOME=@TMP_HOME KUZUSHI_SKIP_ONBOARDING=1 KUZUSHI_REDUCED_MOTION=1 NO_COLOR=1
launch: --target @TMP_TARGET
require-live-snap: 30 KUZUSHI | restarted
paste-file: @ART/resume-command.txt
keys: Enter
require-live-snap: 25 1 planned | recovered-campaign
nav-mode:
keys: a
require-live-snap: 25 PLAN FINDING REVIEW | recovered-plan
expect: Supporting files: 2/2 captured
keys: v End
require-live-snap: 20 STORE_INPUT | recovered-source
expect: SERVICE_INPUT
require-shell: python3 -B @REPO/scripts/devex/fixtures/review_supporting_files.py @TMP_TARGET @ART @TMP_HOME restarted
ask: Does no-color restart preserve the same frozen files and unapproved job with zero requests, approvals or attempts?
keys: Escape
require-live-snap: 20 1 planned | returned-campaign
keys: C-c
require-exit: 10
