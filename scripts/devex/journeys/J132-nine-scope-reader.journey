keys: PgDn
live-snap: report-page-24
require-shell: python3 -B @REPO/scripts/devex/fixtures/large_scopes.py @TMP_TARGET @ART reader-pages
ask: Can narrow Report paging reach every boundary and its three-pass denominator while preserving partial work and unknown dollar cost?
keys: C-c
require-exit: 10
