# J50 — Slash phase routing and full guided pipeline (keyless)
#
# Exercises the real TUI command path. Phase shortcuts must stop at the exact
# planning picker; targetless use must require consent and then resume that
# picker; /full and /pipeline must retain the guided Map-to-Scan entry.
name: Slash phase planners and full pipeline
size: 120x36
cwd: @TMP_TARGET
env-unset: ANTHROPIC_API_KEY OPENAI_API_KEY NO_COLOR
env: HOME=@TMP_HOME COLORTERM=truecolor KUZUSHI_REDUCED_MOTION=1 KUZUSHI_SKIP_ONBOARDING=1
launch: --target @TMP_TARGET
wait-for: 30 KUZUSHI

submit: /map
wait-live-snap: 10 Gather repo context | map-planner
expect: TASKS FOCUS
expect-not: SETUP · MAP PLAN
expect-not: MAP · ROUTE
expect-not: RUN FOCUS

submit: /scan
wait-live-snap: 10 Scan for secrets | scan-planner
expect: TASKS FOCUS
expect-not: MAP · ROUTE
expect-not: RUN FOCUS

submit: /review
wait-live-snap: 10 Triage findings | review-planner
expect: TASKS FOCUS
expect-not: MAP · ROUTE
expect-not: RUN FOCUS

submit: /prove
wait-live-snap: 10 Verify findings | prove-planner
expect: TASKS FOCUS
expect-not: MAP · ROUTE
expect-not: RUN FOCUS

submit: /fix
wait-live-snap: 10 Patch findings | fix-planner
expect: TASKS FOCUS
expect-not: MAP · ROUTE
expect-not: RUN FOCUS

keys: C-c
wait: 2

# A zero-argument phase shortcut never substitutes cwd. Enter explicitly
# selects the candidate and resumes the planner the operator requested.
env-unset: ANTHROPIC_API_KEY OPENAI_API_KEY NO_COLOR
env: HOME=@TMP_HOME COLORTERM=truecolor KUZUSHI_REDUCED_MOTION=1 KUZUSHI_SKIP_ONBOARDING=1
launch:
wait-for: 30 KUZUSHI
submit: /map
wait-live-snap: 10 CHOOSE A TARGET | targetless-map-consent
expect: Nothing defaults to cwd silently
expect-not: Gather repo context
keys: Enter
wait-live-snap: 15 Gather repo context | targetless-map-resumed
expect: Target confirmed:
expect: TASKS FOCUS
expect-not: SETUP · MAP PLAN
expect-not: MAP · ROUTE

keys: C-c
wait: 2

# Only the full workflow accepts a target argument.
env-unset: ANTHROPIC_API_KEY OPENAI_API_KEY NO_COLOR
env: HOME=@TMP_HOME COLORTERM=truecolor KUZUSHI_REDUCED_MOTION=1 KUZUSHI_SKIP_ONBOARDING=1
launch:
wait-for: 30 KUZUSHI
submit: /full @TMP_TARGET
wait-live-snap: 15 MAP · ROUTE | full-guided-route
expect: Map establishes the target context Scan engines will consume.
expect-not: Scan for secrets
expect-not: RUN FOCUS

keys: C-c
wait: 2

env-unset: ANTHROPIC_API_KEY OPENAI_API_KEY NO_COLOR
env: HOME=@TMP_HOME COLORTERM=truecolor KUZUSHI_REDUCED_MOTION=1 KUZUSHI_SKIP_ONBOARDING=1
launch: --target @TMP_TARGET
wait-for: 30 KUZUSHI
submit: /pipeline
wait-live-snap: 15 MAP · ROUTE | pipeline-alias-route
expect: Map establishes the target context Scan engines will consume.
expect-not: Scan for secrets
expect-not: RUN FOCUS
