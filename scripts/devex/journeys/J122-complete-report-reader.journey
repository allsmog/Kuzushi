name: Read the completed investigation report at 40x12 without new work
size: 40x12
cwd: @TARGET
env-unset: ANTHROPIC_API_KEY OPENAI_API_KEY NODE_OPTIONS KUZUSHI_MODEL KUZUSHI_LANGGRAPH_BRIDGE
env: HOME=@TMP_HOME KUZUSHI_REDUCED_MOTION=1 NO_COLOR=1 KUZUSHI_SKIP_ONBOARDING=1
require-shell: python3 -B @REPO/scripts/devex/fixtures/investigation_report_reader.py @TARGET @ART before
launch: --target @TARGET
require-live-snap: 30 KUZUSHI | recovered-investigation
submit: report
require-live-snap: 30 REPORT | report-heading
keys: Home
wait: 0.2
live-snap: reader-page-00
keys: NPage
wait: 0.2
live-snap: reader-page-01
keys: NPage
wait: 0.2
live-snap: reader-page-02
keys: NPage
wait: 0.2
live-snap: reader-page-03
keys: NPage
wait: 0.2
live-snap: reader-page-04
keys: NPage
wait: 0.2
live-snap: reader-page-05
keys: NPage
wait: 0.2
live-snap: reader-page-06
keys: NPage
wait: 0.2
live-snap: reader-page-07
keys: NPage
wait: 0.2
live-snap: reader-page-08
keys: NPage
wait: 0.2
live-snap: reader-page-09
keys: NPage
wait: 0.2
live-snap: reader-page-10
keys: NPage
wait: 0.2
live-snap: reader-page-11
keys: NPage
wait: 0.2
live-snap: reader-page-12
keys: NPage
wait: 0.2
live-snap: reader-page-13
keys: NPage
wait: 0.2
live-snap: reader-page-14
keys: NPage
wait: 0.2
live-snap: reader-page-15
keys: NPage
wait: 0.2
live-snap: reader-page-16
keys: NPage
wait: 0.2
live-snap: reader-page-17
keys: NPage
wait: 0.2
live-snap: reader-page-18
keys: NPage
wait: 0.2
live-snap: reader-page-19
keys: NPage
wait: 0.2
live-snap: reader-page-20
keys: NPage
wait: 0.2
live-snap: reader-page-21
keys: NPage
wait: 0.2
live-snap: reader-page-22
keys: NPage
wait: 0.2
live-snap: reader-page-23
keys: NPage
wait: 0.2
live-snap: reader-page-24
keys: NPage
wait: 0.2
live-snap: reader-page-25
keys: NPage
wait: 0.2
live-snap: reader-page-26
keys: NPage
wait: 0.2
live-snap: reader-page-27
keys: NPage
wait: 0.2
live-snap: reader-page-28
keys: NPage
wait: 0.2
live-snap: reader-page-29
require-shell: python3 -B @REPO/scripts/devex/fixtures/investigation_report_reader.py @TARGET @ART after
ask: Does keyboard paging expose findings, source, frozen context, model, unknown cost, protected Review and the report controls at 40x12 without new work?
keys: C-c
require-exit: 10
