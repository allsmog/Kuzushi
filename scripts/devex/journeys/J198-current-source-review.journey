name: Explicit human review captures current dirty source without inventing an observation or fix
size: 120x36
cwd: @TMP_TARGET
env-unset: ANTHROPIC_API_KEY OPENAI_API_KEY OPENROUTER_API_KEY GEMINI_API_KEY KUZUSHI_MODEL KUZUSHI_LANGGRAPH_BRIDGE NODE_OPTIONS NO_COLOR
env: HOME=@TMP_HOME KUZUSHI_SKIP_ONBOARDING=1 KUZUSHI_REDUCED_MOTION=1
require-shell: python3 -B @REPO/scripts/devex/fixtures/current_source_review.py @TMP_TARGET @ART seed @TMP_HOME
require-wrapper-flow:
launch: --target @TMP_TARGET/repository
submit: findings
require-live-snap: 25 FINDINGS · 1 | original-observation
nav-mode:
keys: Enter
submit: decision fp Owned public documentation example is intentional
require-live-snap: 25 recorded observation revision-base-003 | original-source-decision
require-shell: python3 -B @REPO/scripts/devex/fixtures/current_source_review.py @TMP_TARGET @ART advance
submit: findings
nav-mode:
keys: Enter
require-live-snap: 25 review current source | current-source-action
keys: Y
require-live-snap: 25 run findings:review-source | explicit-capture-draft
keys: Enter
require-live-snap: 25 declared WorkspaceWrite | explicit-capture-approval
keys: y
require-shell: python3 -B @REPO/scripts/devex/fixtures/current_source_review.py @TMP_TARGET @ART captured
submit: logs
require-live-snap: 25 Source reference: review-source: | actual-current-capture
require-shell: python3 -B @REPO/scripts/devex/fixtures/current_source_review.py @TMP_TARGET @ART decide
submit: findings
nav-mode:
keys: Enter
require-live-snap: 30 explicitly reviewed source capture | captured-source-decision
expect: Reviewed commit
expect: dirty
expect: Prior observation: revision-later
resize: 160x48
live-snap: current-source-160x48
resize: 96x89
live-snap: current-source-96x89
resize: 80x24
live-snap: current-source-80x24
resize: 60x20
live-snap: current-source-60x20
resize: 40x12
live-snap: current-source-40x12
keys: NPage
live-snap: current-source-40x12-gap
keys: NPage
live-snap: current-source-40x12-decision
keys: NPage
live-snap: current-source-40x12-basis
keys: NPage
live-snap: current-source-40x12-prior
keys: NPage
require-live-snap: 25 Reviewed commit | current-source-40x12-commit
expect: dirty
ask: Does source review distinguish the explicitly reviewed dirty source from the prior observed source, without claiming a fix or changing raw observations?
resize: 120x36
require-shell: python3 -B @REPO/scripts/devex/fixtures/current_source_review.py @TMP_TARGET @ART verify
require-shell: python3 -B @REPO/scripts/devex/fixtures/current_source_review.py @TMP_TARGET @ART exports
keys: C-c
require-exit: 10
env: HOME=@TMP_HOME KUZUSHI_SKIP_ONBOARDING=1 KUZUSHI_REDUCED_MOTION=1 NO_COLOR=1
launch: --target @TMP_TARGET/repository
submit: findings
nav-mode:
keys: Enter
require-live-snap: 30 explicitly reviewed source capture | recovered-explicit-source
expect: dirty
expect: Prior observation: revision-later
require-shell: python3 -B @REPO/scripts/devex/fixtures/current_source_review.py @TMP_TARGET @ART verify
ask: Does restart retain both human decisions and four real observations, with captured-source metadata and no provider work?
keys: C-c
require-exit: 10
