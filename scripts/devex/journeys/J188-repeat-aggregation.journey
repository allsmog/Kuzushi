name: Repeated observations preserve chronology and approve the exact Review generation
size: 120x36
cwd: @TMP_TARGET
env-unset: ANTHROPIC_API_KEY OPENAI_API_KEY KUZUSHI_MODEL NODE_OPTIONS NO_COLOR
env: HOME=@TMP_HOME KUZUSHI_SKIP_ONBOARDING=1 KUZUSHI_REDUCED_MOTION=1
require-shell: python3 -B @REPO/scripts/devex/fixtures/repeat_aggregation.py @TMP_TARGET @ART seed @TMP_HOME
require-wrapper-flow:
launch: --target @TMP_TARGET
submit: findings
require-live-snap: 30 FINDINGS · 1 | aggregated-finding
nav-mode:
keys: Enter
require-live-snap: 25 SELECTED FINDING | source-detail
expect: sources:1
resize: 160x48
live-snap: source-history-160x48
keys: NPage
live-snap: wide-history-page-1
keys: NPage
live-snap: wide-history-page-2
keys: NPage
live-snap: wide-history-page-3
keys: NPage
live-snap: wide-history-page-4
keys: NPage
live-snap: wide-history-page-5
keys: NPage
live-snap: wide-history-page-6
resize: 96x89
live-snap: source-history-96x89
resize: 80x24
live-snap: source-history-80x24
resize: 60x20
live-snap: source-history-60x20
resize: 40x12
live-snap: source-history-40x12
keys: NPage NPage NPage NPage NPage NPage NPage NPage NPage NPage
live-snap: compact-source-history
require-shell: python3 -B @REPO/scripts/devex/fixtures/repeat_aggregation.py @TMP_TARGET @ART screens
resize: 120x36
submit: campaign owned-repeat-review
require-live-snap: 25 owned-repeat-review | unlaunched-review
nav-mode:
keys: a
require-live-snap: 25 PLAN FINDING REVIEW | exact-generation
keys: t
require-live-snap: 15 Total calls | total-editor
keys: 2 Enter
keys: r
require-live-snap: 15 Protected review | protected-editor
keys: 2 Enter
keys: Enter
require-live-snap: 25 Total provider calls: 2 | exact-review-approval
keys: y
require-live-snap: 25 Approval saved | approved-multiple-observations
require-shell: python3 -B @REPO/scripts/devex/fixtures/repeat_aggregation.py @TMP_TARGET @ART approved
ask: Does repeated discovery retain one consolidated identity, ordered observation history and a separately approved raw-generation Review without inventing confidence or spending?
keys: Enter
require-live-snap: 25 Review plan approved | approved-jobs
keys: C-c
require-exit: 10
env: HOME=@TMP_HOME KUZUSHI_SKIP_ONBOARDING=1 KUZUSHI_REDUCED_MOTION=1 NO_COLOR=1
launch: --target @TMP_TARGET
submit: campaign owned-repeat-review
require-live-snap: 25 owned-repeat-review | restarted-campaign
nav-mode:
keys: a
require-live-snap: 25 PLAN FINDING REVIEW | restarted-plan
require-shell: python3 -B @REPO/scripts/devex/fixtures/repeat_aggregation.py @TMP_TARGET @ART restarted
keys: Escape
require-live-snap: 20 owned-repeat-review | restored-origin
expect-not: PLAN FINDING REVIEW
keys: C-c
require-exit: 10
