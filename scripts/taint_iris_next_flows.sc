// taint-iris-next Joern dataflow query.
//
// Takes the path to a CPG and a JSON file describing per-CWE source/sink
// regex pairs, runs `cpg.call.code(<sink>).reachableByFlows(cpg.call.code(<source>))`
// for each pair, and emits one JSON object per flow path on stdout.
//
// Invocation contract (matches what joern_dataflow.rs writes):
//   joern --script taint_iris_next_flows.sc \
//         --param cpgFile=<path> \
//         --param queriesFile=<path>
//
// queriesFile JSON shape:
//   [
//     { "cwe": "CWE-89", "taintClass": "sql-injection",
//       "sourceRegex": "(req\\.query|request\\.args)",
//       "sinkRegex":   "(db\\.query|\\.execute\\()" },
//     ...
//   ]
//
// Each flow becomes one stdout line:
//   {"cwe":"CWE-89","taintClass":"sql-injection","filePath":"src/routes/users.ts",
//    "sourceLine":12,"sinkLine":13,"sourceCode":"...","sinkCode":"...",
//    "steps":[{"file":"...","line":12,"code":"..."}, ...]}
//
// Non-flow output (info logs, banners) goes to stderr — the calling Rust
// code parses stdout line-by-line and ignores blank/non-JSON lines.

import io.shiftleft.semanticcpg.language._
import io.shiftleft.codepropertygraph.generated.nodes.Call
import io.joern.dataflowengineoss.language._
import scala.util.Try
import java.util.concurrent.{Callable, Executors, TimeUnit, TimeoutException}

@main def main(cpgFile: String, queriesFile: String): Unit = {
  importCpg(cpgFile)

  val rawQueries = better.files.File(queriesFile).contentAsString
  // Tiny ad-hoc JSON parser to avoid pulling in an extra Scala JSON dep
  // beyond what Joern already ships. Each query record is an object with
  // four string fields; the input is generated by Rust so we can rely on
  // the shape.
  val queries = parseQueries(rawQueries)

  System.err.println(s"[taint-iris-next] loaded ${queries.size} CWE queries")
  // Hard caps to keep `reachableByFlows` tractable on large CPGs (e.g.
  // postgres at 187MB CPG matches tens of thousands of `length` /
  // `palloc` calls, and the cross-product flow analysis is exponential).
  // We only need a few high-quality flows per CWE for the agent to
  // reason about — Joern's flow ranker generally surfaces the
  // shortest/most-direct paths first.
  val maxSourcesPerCwe = 200
  val maxSinksPerCwe = 200
  val maxFlowsPerCwe = 25
  // Per-CWE wall-clock budget. `reachableByFlows` is exponential and one
  // catastrophically broad CWE pattern (CWE-209 `ereport`, CWE-416
  // `palloc`/`pfree`) can deadlock the entire script even with the
  // size caps above. Default 60s; operators set
  // KUZUSHI_JOERN_PER_CWE_TIMEOUT_MS=<N> to widen or 0 to disable
  // (use 0 with caution — a single hang locks the whole hunt).
  val perCweTimeoutMs: Long = Option(System.getenv("KUZUSHI_JOERN_PER_CWE_TIMEOUT_MS"))
    .flatMap(s => Try(s.toLong).toOption)
    .getOrElse(60000L)
  // One reusable single-thread executor. We can't reliably interrupt
  // joern's iterator-based traversals (Thread.interrupted() isn't
  // checked inside `reachableByFlows`), so a cancelled task may keep
  // running in the background; bounding to one thread caps peak
  // memory pressure at one zombie task.
  val executor = Executors.newSingleThreadExecutor()
  try {
    for (q <- queries) {
      val sources = Try(cpg.call.code(q.sourceRegex).take(maxSourcesPerCwe).l).getOrElse(Nil)
      val sinks = Try(cpg.call.code(q.sinkRegex).take(maxSinksPerCwe).l).getOrElse(Nil)
      System.err.println(s"[taint-iris-next] ${q.cwe}: ${sources.size} sources (capped at $maxSourcesPerCwe), ${sinks.size} sinks (capped at $maxSinksPerCwe)")
      if (sources.nonEmpty && sinks.nonEmpty) {
        val task: Callable[List[io.joern.dataflowengineoss.language.Path]] = () =>
          sinks.reachableByFlows(sources).take(maxFlowsPerCwe).l
        val future = executor.submit(task)
        val flowsOpt =
          if (perCweTimeoutMs <= 0L) Try(future.get()).toOption
          else
            try Some(future.get(perCweTimeoutMs, TimeUnit.MILLISECONDS))
            catch {
              case _: TimeoutException =>
                future.cancel(true)
                System.err.println(s"[taint-iris-next] ${q.cwe}: TIMEOUT after ${perCweTimeoutMs}ms with ${sources.size} sources x ${sinks.size} sinks; skipping")
                None
              case t: Throwable =>
                System.err.println(s"[taint-iris-next] ${q.cwe}: ERROR ${t.getClass.getSimpleName}: ${t.getMessage}; skipping")
                None
            }
        val flows = flowsOpt.getOrElse(Nil)
        System.err.println(s"[taint-iris-next] ${q.cwe}: ${flows.size} flows")
        for (flow <- flows) {
          emitFlow(q, flow)
        }
      }
    }
  } finally {
    // shutdownNow returns Runnables that were queued but never started; we
    // don't run them. The currently-executing task is interrupted but may
    // not honor it — that's why we restrict to one worker.
    executor.shutdownNow()
  }
}

case class CweQuery(cwe: String, taintClass: String, sourceRegex: String, sinkRegex: String)

def parseQueries(raw: String): List[CweQuery] = {
  // Strip the outer brackets, split on `},{` boundaries, then parse each
  // object's known string fields. Survives unicode in code snippets
  // because Rust serde_json escapes them.
  val inner = raw.trim.stripPrefix("[").stripSuffix("]").trim
  if (inner.isEmpty) return Nil
  splitObjects(inner).map(parseObject)
}

def splitObjects(s: String): List[String] = {
  val out = scala.collection.mutable.ListBuffer.empty[String]
  var depth = 0
  var start = -1
  var inString = false
  var escape = false
  for (i <- 0 until s.length) {
    val ch = s.charAt(i)
    if (escape) {
      escape = false
    } else if (inString) {
      if (ch == '\\') escape = true
      else if (ch == '"') inString = false
    } else {
      if (ch == '"') inString = true
      else if (ch == '{') {
        if (depth == 0) start = i
        depth += 1
      } else if (ch == '}') {
        depth -= 1
        if (depth == 0 && start >= 0) {
          out += s.substring(start, i + 1)
          start = -1
        }
      }
    }
  }
  out.toList
}

def parseObject(obj: String): CweQuery = {
  CweQuery(
    cwe = readString(obj, "cwe"),
    taintClass = readString(obj, "taintClass"),
    sourceRegex = readString(obj, "sourceRegex"),
    sinkRegex = readString(obj, "sinkRegex"),
  )
}

def readString(obj: String, key: String): String = {
  val needle = "\"" + key + "\""
  val keyIdx = obj.indexOf(needle)
  if (keyIdx < 0) return ""
  val after = obj.substring(keyIdx + needle.length)
  val colonIdx = after.indexOf(':')
  if (colonIdx < 0) return ""
  val afterColon = after.substring(colonIdx + 1).dropWhile(_.isWhitespace)
  if (!afterColon.startsWith("\"")) return ""
  val body = afterColon.substring(1)
  val sb = new StringBuilder
  var i = 0
  var escape = false
  while (i < body.length) {
    val ch = body.charAt(i)
    if (escape) {
      ch match {
        case 'n' => sb.append('\n')
        case 't' => sb.append('\t')
        case 'r' => sb.append('\r')
        case '\\' => sb.append('\\')
        case '"' => sb.append('"')
        case '/' => sb.append('/')
        case other => sb.append(other)
      }
      escape = false
      i += 1
    } else if (ch == '\\') {
      escape = true
      i += 1
    } else if (ch == '"') {
      return sb.toString
    } else {
      sb.append(ch)
      i += 1
    }
  }
  sb.toString
}

def emitFlow(q: CweQuery, flow: io.joern.dataflowengineoss.language.Path): Unit = {
  val elements = flow.elements
  if (elements.isEmpty) return
  val first = elements.head
  val last = elements.last
  val filename = Option(first.location.filename).getOrElse("")
  val sourceLine = first.location.lineNumber.getOrElse(0)
  val sinkLine = last.location.lineNumber.getOrElse(0)
  val sourceCode = trimCode(first.code)
  val sinkCode = trimCode(last.code)

  val steps = elements.map { e =>
    val f = Option(e.location.filename).getOrElse("")
    val l = e.location.lineNumber.getOrElse(0)
    val c = trimCode(e.code)
    s"""{"file":${jsonEscape(f)},"line":$l,"code":${jsonEscape(c)}}"""
  }

  val payload = s"""{"cwe":${jsonEscape(q.cwe)},"taintClass":${jsonEscape(q.taintClass)},"filePath":${jsonEscape(filename)},"sourceLine":$sourceLine,"sinkLine":$sinkLine,"sourceCode":${jsonEscape(sourceCode)},"sinkCode":${jsonEscape(sinkCode)},"steps":[${steps.mkString(",")}]}"""
  println(payload)
}

def trimCode(code: String): String = {
  val collapsed = code.linesIterator.map(_.trim).mkString(" ")
  if (collapsed.length > 240) collapsed.substring(0, 240) + "..." else collapsed
}

def jsonEscape(s: String): String = {
  val sb = new StringBuilder
  sb.append('"')
  for (ch <- s) {
    ch match {
      case '"' => sb.append("\\\"")
      case '\\' => sb.append("\\\\")
      case '\n' => sb.append("\\n")
      case '\r' => sb.append("\\r")
      case '\t' => sb.append("\\t")
      case c if c < 0x20 => sb.append("\\u%04x".format(c.toInt))
      case c => sb.append(c)
    }
  }
  sb.append('"')
  sb.toString
}
