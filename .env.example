# Kuzushi environment variables.
# Copy to `.env` (git-ignored) and fill in the keys for the providers you use.
# The CLI only needs keys for models you actually invoke via `--model provider:id`.

# ── Anthropic (default provider) ────────────────────────────────────
# Used by: --model anthropic:* and the default model.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenAI ──────────────────────────────────────────────────────────
# Used by: --model openai:*
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL is only needed for OpenAI-compatible proxies (e.g. Ollama).
# OPENAI_BASE_URL=http://localhost:11434/v1

# ── Google / Gemini ─────────────────────────────────────────────────
# Either variable works; GEMINI_API_KEY is preferred.
# GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Ollama (local models) ───────────────────────────────────────────
# Kuzushi talks to Ollama via its OpenAI-compatible endpoint. Point OPENAI_API_KEY
# at anything (Ollama ignores it) and set OPENAI_BASE_URL as shown above.
