{
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scopes", "sharedScope", "sharedDiscovery", "exclusions"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "scopes": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/scope" } },
    "sharedScope": { "anyOf": [{ "$ref": "#/$defs/scope" }, { "type": "null" }] },
    "sharedDiscovery": { "type": "boolean", "const": false },
    "exclusions": { "type": "array", "maxItems": 0, "items": { "type": "object", "additionalProperties": false, "properties": {}, "required": [] } }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "paths", "rationale", "sharedDependencies", "openQuestions"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "paths": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "maxLength": 1024 } },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "sharedDependencies": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 64 } },
        "openQuestions": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 512 } }
      }
    }
  }
}
