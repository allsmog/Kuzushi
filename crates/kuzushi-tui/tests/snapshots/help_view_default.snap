[--allow-empty], /workspace export findings <path> [format] [--completeness open|complete] [--allow-empty], workspace
export findings <path> [format] [--completeness open|complete] [--allow-empty], export <path> [format] [--completeness
open|complete] [--allow-empty]
workspace scope init - write an editable .kuzushi/scope.toml scaffold
  aliases / examples: /workspace scope init

FINDINGS / EVIDENCE — browse findings, evidence, and report output
findings - open persisted findings
  aliases / examples: /f, f, /findings
findings filter <expr> - filter findings by severity, confidence, decision, or completeness; use clear to reset
aliases / examples: findings filter state:new rank:high, findings filter decision:confirmed completeness:open, findings
filter confidence:confirmed, findings filter clear, /findings filter <expr>
component <scope|path|all> - focus Workbench findings on a detected component
  aliases / examples: component web/app, component entrypoint-cmd-proxy, component all
open <id> - open a finding alias or fingerprint
  aliases / examples: open F-0001, /open <id>
decision <verdict> <reason> - record triage status; use dismiss for false positives or suppress for a rule
aliases / examples: decision confirmed reviewed source-linked evidence, decision deferred needs runtime harness,
decision needs_review confirm the trust boundary
proof defer <id> --reason <text> - record a human proof deferral for the current finding generation
  aliases / examples: /proof defer F-0001 --reason production harness unavailable
dismiss <reason> <note> - dismiss the selected finding with a structured, auditable reason
  aliases / examples: dismiss false_positive not reachable in prod, dismiss used_in_tests test fixture only
suppress <id> --reason <text> [--author operator] [--days 90] - record an expiring suppression rule plus its human
review decision
  aliases / examples: /suppress F-0001 --reason false-positive, /x F-0001 --reason false-positive
show aliases [prefix] - list finding aliases
  aliases / examples: /show aliases [prefix]
show runs - recent run artifacts
  aliases / examples: /show runs, runs, /runs
jobs - live + recent run registry
  aliases / examples: /jobs, jobs list
campaign [id] - campaign deck: planned job matrix + dispatcher queue state
  aliases / examples: /campaign, campaigns
batch <id>|clear - open a scan-batch occurrence report and retain or clear its Review scope
  aliases / examples: /batch <id>
coverage - coverage matrix: shards x threat sources with campaign progress + finding counts
  aliases / examples: /coverage
jobs -k <runId> - cancel a running job or drop a pending one
  aliases / examples: jobs kill <runId>, jobs cancel <runId>
runs diff <left> <right> - compare findings snapshots from two runs
  aliases / examples: runs diff <runA> <runB>, runs compare <runA> <runB>
replay <run|latest> - render a run summary
  aliases / examples: /replay <run|latest>, replay latest
trace <run> - stream run events
  aliases / examples: /trace <run>
activity - live module-progress dashboard
  aliases / examples: /activity, progress, /progress, /a
handoff - latest bounded failure handoff
  aliases / examples: /handoff, failure, /failure
verify <finding> - verify a finding's exploitability (runs verify:finding)
  aliases / examples: verify F-0001, /verify F-0001, /v F-0001
patch <finding> - draft a remediation for a finding (runs patch:finding)
  aliases / examples: patch F-0001, /patch F-0001
