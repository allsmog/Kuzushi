{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kuzushi.dev/schemas/run.findings.schema.json",
  "title": "Kuzushi Run Findings Snapshot",
  "description": "Derived export schema for .kuzushi/runs/<runId>/findings.json. Producer snapshots are arrays or objects of findings; the file is absent until a producer emits it.",
  "type": ["object", "array"],
  "additionalProperties": true,
  "items": { "$ref": "#/definitions/finding" },
  "properties": {
    "runId": { "type": "string" },
    "status": { "$ref": "#/definitions/status" },
    "summary": { "type": "string" },
    "artifacts": { "type": "array" },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "coreFindings": {
      "type": "array",
      "items": { "$ref": "#/definitions/finding" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/definitions/finding" }
    }
  },
  "definitions": {
    "status": {
      "type": "string",
      "enum": ["running", "completed", "failed", "interrupted", "partial", "skipped", "paused"]
    },
    "finding": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "fingerprint": { "type": "string" },
        "tool": { "type": "string" },
        "ruleId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "severity": { "$ref": "#/definitions/severity" },
        "confidence": { "$ref": "#/definitions/confidence" },
        "filePath": { "type": "string" },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "staticProofState": { "$ref": "#/definitions/proofState" },
        "properties": {
          "type": "object",
          "additionalProperties": true
        },
        "cwe": { "type": ["string", "array"] },
        "evidence": { "type": ["string", "array", "object"] },
        "suppressed": { "type": "boolean" },
        "snoozedUntil": { "type": "string" },
        "remediation": { "type": "string" },
        "references": { "type": "array" }
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info",
        "unknown",
        "ERROR",
        "WARNING",
        "INFO"
      ]
    },
    "confidence": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["high", "medium", "low", "unknown", "HIGH", "MEDIUM", "LOW", "UNKNOWN"]
        },
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "integer", "minimum": 0, "maximum": 100 }
      ]
    },
    "proofState": {
      "type": "string",
      "enum": [
        "signal_only",
        "code_cited",
        "source_sink_linked",
        "sanitizer_checked",
        "statically_confirmed",
        "statically_rejected",
        "needs_runtime_evidence",
        "execution_confirmed",
        "runtime_confirmed",
        "dynamic_confirmed",
        "exploit_confirmed",
        "poc_confirmed",
        "runtime_reviewed",
        "execution_attempted",
        "execution_rejected"
      ]
    }
  }
}
