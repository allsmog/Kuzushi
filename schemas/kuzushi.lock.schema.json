{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kuzushi.dev/kuzushi.lock.schema.json",
  "title": "Kuzushi KWP lockfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["modules"],
  "properties": {
    "modules": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/lockEntry" }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "lockEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleId", "digest", "version", "descriptorHash", "grant"],
      "properties": {
        "moduleId": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "version": { "type": "string", "minLength": 1 },
        "descriptorHash": { "$ref": "#/$defs/digest" },
        "grant": { "$ref": "#/$defs/grant" },
        "signatureChain": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ed25519:v1:[^:]+:[A-Za-z0-9+/]+={0,2}$"
          },
          "default": []
        },
        "revoked": { "type": "boolean", "default": false }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fs": {
          "type": "array",
          "items": { "$ref": "#/$defs/fsGrant" },
          "default": []
        },
        "net": { "$ref": "#/$defs/netGrant" },
        "runtime": { "$ref": "#/$defs/runtimeGrant" },
        "bus": { "$ref": "#/$defs/busGrant" },
        "findings": { "$ref": "#/$defs/findingsGrant" },
        "artifacts": { "$ref": "#/$defs/artifactsGrant" },
        "mcp": {
          "type": "array",
          "items": { "$ref": "#/$defs/mcpGrant" },
          "default": []
        },
        "fuzz": { "$ref": "#/$defs/fuzzGrant" },
        "exec": {
          "type": "array",
          "items": { "$ref": "#/$defs/execGrant" }
        },
        "initCapabilities": { "enum": ["fs-read"] }
      }
    },
    "fsGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "mode"],
      "properties": {
        "scope": { "enum": ["workspace", "module-data", "input"] },
        "mode": { "enum": ["ro", "rw"] },
        "maxBytes": { "type": "integer", "minimum": 0 },
        "maxFiles": { "type": "integer", "minimum": 0 }
      }
    },
    "netGrant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "credentials": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "maxRequestsPerInvocation": { "type": "integer", "minimum": 0 },
        "maxBytesPerInvocation": { "type": "integer", "minimum": 0 }
      }
    },
    "runtimeGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxCostUsdPerInvocation", "maxCostUsdPerRun"],
      "properties": {
        "maxCostUsdPerInvocation": { "type": "number", "minimum": 0 },
        "maxCostUsdPerRun": { "type": "number", "minimum": 0 },
        "models": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "busGrant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "produce": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "consume": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "findingsGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create"],
      "properties": {
        "create": { "type": "boolean" },
        "maxPerInvocation": { "type": "integer", "minimum": 0 },
        "allowedSeverities": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "artifactsGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["write"],
      "properties": {
        "write": { "type": "boolean" },
        "maxBytesPerInvocation": { "type": "integer", "minimum": 0 }
      }
    },
    "mcpGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "mode", "workspace"],
      "properties": {
        "alias": { "type": "string", "minLength": 1 },
        "tools": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "mode": { "enum": ["shared", "dedicated"] },
        "maxCallsPerInvocation": { "type": "integer", "minimum": 0 },
        "maxCpuSecondsPerInvocation": { "type": "integer", "minimum": 0 },
        "maxBytesPerInvocation": { "type": "integer", "minimum": 0 },
        "maxArtifactsBytesPerInvocation": { "type": "integer", "minimum": 0 },
        "workspace": { "enum": ["read-only", "scratch-only", "read-write"] }
      }
    },
    "fuzzGrant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engines": {
          "type": "array",
          "items": {
            "enum": [
              "cargo-fuzz",
              "libfuzzer",
              "aflplusplus",
              "jazzer",
              "go-fuzz",
              "atheris",
              "js-fuzzilli",
              "property-tests",
              "symcc"
            ]
          },
          "default": []
        },
        "maxJobsPerInvocation": { "type": "integer", "minimum": 0 },
        "maxCpuSecondsPerInvocation": { "type": "integer", "minimum": 0 },
        "maxArtifactsBytesPerInvocation": { "type": "integer", "minimum": 0 },
        "network": { "type": "boolean", "default": false }
      }
    },
    "execGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bin"],
      "properties": {
        "bin": { "type": "string", "minLength": 1 },
        "argvAllow": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    }
  }
}
