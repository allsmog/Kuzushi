{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kuzushi.dev/schemas/run.proof.schema.json",
  "title": "Kuzushi Run Proof Snapshot",
  "description": "Canonical schema for .kuzushi/runs/<runId>/proof.json. Rich producer snapshots may be static proof summaries or verification proof results; deterministic absence markers use the shared run snapshot marker fields.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "runId": { "type": "string" },
    "run_id": { "type": "string" },
    "status": { "$ref": "#/definitions/runStatus" },
    "runStatus": { "$ref": "#/definitions/runStatus" },
    "summary": { "type": "string" },
    "artifacts": { "type": "array" },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "proof": { "type": "object" },
    "proofs": { "type": ["object", "array"] },
    "verification": { "type": "object" },
    "source": { "type": "string" },
    "kind": { "$ref": "#/definitions/proofKind" },
    "proofLevel": { "$ref": "#/definitions/proofLevel" },
    "proof_level": { "$ref": "#/definitions/proofLevel" },
    "proofVerdict": { "$ref": "#/definitions/proofVerdict" },
    "proof_verdict": { "$ref": "#/definitions/proofVerdict" },
    "runtimeVerification": { "type": "boolean" },
    "runtime_verification": { "type": "boolean" },
    "countsByState": { "type": "object" },
    "counts_by_state": { "type": "object" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/definitions/proofFinding" }
    },
    "verified": { "type": "integer", "minimum": 0 },
    "verifiedCount": { "type": "integer", "minimum": 0 },
    "verified_count": { "type": "integer", "minimum": 0 },
    "results": { "type": "array" },
    "verificationResults": { "type": "array" },
    "verification_results": { "type": "array" }
  },
  "definitions": {
    "runStatus": {
      "type": "string",
      "enum": ["running", "completed", "failed", "interrupted", "partial", "skipped", "paused"]
    },
    "proofKind": {
      "type": "string",
      "enum": [
        "verification",
        "llm-exploitability-review",
        "empirical-verification",
        "verification-outcome",
        "patch-validation"
      ]
    },
    "proofLevel": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["runtime-and-static", "static-signal-only"]
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      ]
    },
    "proofVerdict": {
      "type": "string",
      "enum": [
        "confirmed",
        "exploited",
        "not_reproduced",
        "harness_failed_to_build",
        "infrastructure_error",
        "language_unsupported_yet",
        "insufficient_finding_detail",
        "needs-runtime-evidence"
      ]
    },
    "proofFinding": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "fingerprint": { "type": "string" },
        "tool": { "type": "string" },
        "ruleId": { "type": "string" },
        "rule_id": { "type": "string" },
        "filePath": { "type": "string" },
        "file_path": { "type": "string" },
        "startLine": { "type": ["integer", "null"], "minimum": 1 },
        "start_line": { "type": ["integer", "null"], "minimum": 1 },
        "staticProofState": { "$ref": "#/definitions/proofState" },
        "static_proof_state": { "$ref": "#/definitions/proofState" }
      }
    },
    "proofState": {
      "type": "string",
      "enum": [
        "signal_only",
        "code_cited",
        "source_sink_linked",
        "sanitizer_checked",
        "statically_confirmed",
        "statically_rejected",
        "needs_runtime_evidence",
        "execution_confirmed",
        "runtime_confirmed",
        "dynamic_confirmed",
        "exploit_confirmed",
        "poc_confirmed",
        "runtime_reviewed",
        "execution_attempted",
        "execution_rejected"
      ]
    }
  }
}
