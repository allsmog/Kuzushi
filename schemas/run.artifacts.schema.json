{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kuzushi.dev/schemas/run.artifacts.schema.json",
  "title": "Kuzushi Run Artifact Manifest",
  "description": "Canonical schema for .kuzushi/v3/runs/<runId>/artifacts.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "artifacts"
  ],
  "properties": {
    "runId": {
      "$ref": "#/definitions/nonEmptyString"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/artifact"
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/artifactObject"
      }
    }
  },
  "definitions": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "path",
        "kind"
      ],
      "allOf": [
        {
          "$ref": "#/definitions/canonicalArtifactMetadata"
        }
      ],
      "properties": {
        "label": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "path": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "kind": {
          "$ref": "#/definitions/artifactKind"
        }
      }
    },
    "artifactObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "path",
        "objectRef"
      ],
      "properties": {
        "label": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "path": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "objectRef": {
          "$ref": "#/definitions/objectRef"
        }
      }
    },
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "hash",
        "sizeBytes"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "hash": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "canonicalArtifactMetadata": {
      "allOf": [
        {
          "if": {
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "pattern": "(^|/)run\\.json$"
              }
            }
          },
          "then": {
            "properties": {
              "label": {
                "const": "run metadata"
              },
              "kind": {
                "const": "json"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "pattern": "(^|/)events\\.jsonl$"
              }
            }
          },
          "then": {
            "properties": {
              "label": {
                "const": "run events"
              },
              "kind": {
                "const": "jsonl"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "pattern": "(^|/)items\\.jsonl$"
              }
            }
          },
          "then": {
            "properties": {
              "label": {
                "const": "semantic run items"
              },
              "kind": {
                "const": "jsonl"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "pattern": "(^|/)stages\\.jsonl$"
              }
            }
          },
          "then": {
            "properties": {
              "label": {
                "const": "tool stage receipts"
              },
              "kind": {
                "const": "jsonl"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "pattern": "(^|/)context\\.json$"
              }
            }
          },
          "then": {
            "properties": {
              "label": {
                "const": "context snapshot"
              },
              "kind": {
                "const": "json"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "pattern": "(^|/)attack-surface\\.json$"
              }
            }
          },
          "then": {
            "properties": {
              "label": {
                "const": "attack surface"
              },
              "kind": {
                "const": "json"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "pattern": "(^|/)threat-model\\.json$"
              }
            }
          },
          "then": {
            "properties": {
              "label": {
                "const": "threat model"
              },
              "kind": {
                "const": "json"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "pattern": "(^|/)recommendations\\.json$"
              }
            }
          },
          "then": {
            "properties": {
              "label": {
                "const": "recommendations"
              },
              "kind": {
                "const": "json"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "pattern": "(^|/)strategy\\.json$"
              }
            }
          },
          "then": {
            "properties": {
              "label": {
                "const": "strategy proposals"
              },
              "kind": {
                "const": "json"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "pattern": "(^|/)findings\\.json$"
              }
            }
          },
          "then": {
            "properties": {
              "label": {
                "const": "findings"
              },
              "kind": {
                "const": "json"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "pattern": "(^|/)proof\\.json$"
              }
            }
          },
          "then": {
            "properties": {
              "label": {
                "const": "proof"
              },
              "kind": {
                "const": "json"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "pattern": "(^|/)failures\\.json$"
              }
            }
          },
          "then": {
            "properties": {
              "label": {
                "const": "failure handoff"
              },
              "kind": {
                "const": "json"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "pattern": "(^|/)report\\.md$"
              }
            }
          },
          "then": {
            "properties": {
              "label": {
                "const": "report"
              },
              "kind": {
                "const": "markdown"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "pattern": "(^|/)artifacts\\.json$"
              }
            }
          },
          "then": {
            "properties": {
              "label": {
                "const": "artifact manifest"
              },
              "kind": {
                "const": "json"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "pattern": "(^|/)report\\.sarif$"
              }
            }
          },
          "then": {
            "properties": {
              "label": {
                "const": "SARIF report"
              },
              "kind": {
                "const": "sarif"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "pattern": "(^|/)input\\.json$"
              }
            }
          },
          "then": {
            "properties": {
              "label": {
                "const": "tool input"
              },
              "kind": {
                "const": "json"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "pattern": "(^|/)result\\.json$"
              }
            }
          },
          "then": {
            "properties": {
              "label": {
                "const": "tool result"
              },
              "kind": {
                "const": "json"
              }
            }
          }
        }
      ]
    },
    "artifactKind": {
      "type": "string",
      "enum": [
        "json",
        "jsonl",
        "markdown",
        "sarif",
        "directory",
        "artifact"
      ]
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
