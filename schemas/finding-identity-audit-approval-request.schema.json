{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kuzushi.dev/schemas/finding-identity-audit-approval-request.schema.json",
  "title": "Kuzushi Finding Identity Audit Approval Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "canonicalTargetKey",
    "corpusWatermark",
    "reportSha256",
    "actor",
    "dispositions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "canonicalTargetKey": { "type": "string", "minLength": 1 },
    "corpusWatermark": { "$ref": "#/definitions/sha256" },
    "reportSha256": { "$ref": "#/definitions/sha256" },
    "actor": { "type": "string", "minLength": 1 },
    "dispositions": {
      "type": "array",
      "items": { "$ref": "#/definitions/disposition" }
    }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identityId", "disposition", "rationale"],
      "properties": {
        "identityId": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["accepted", "fixed"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
