{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kuzushi.dev/schemas/run.failures.schema.json",
  "title": "Kuzushi Run Failures",
  "description": "Canonical schema for .kuzushi/v3/runs/<runId>/failures.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "status",
    "failures"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "$ref": "#/definitions/runStatus"
    },
    "failures": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/definitions/failure"
      }
    }
  },
  "definitions": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "path",
        "kind"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/definitions/artifactKind"
        }
      }
    },
    "artifactKind": {
      "type": "string",
      "enum": [
        "json",
        "jsonl",
        "markdown",
        "sarif",
        "directory",
        "artifact"
      ]
    },
    "runStatus": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "failed",
        "canceled",
        "interrupted",
        "partial",
        "skipped",
        "paused"
      ]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "status",
        "error",
        "agentThreadContext"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/runStatus"
        },
        "error": {
          "type": "string"
        },
        "agentThreadContext": {
          "$ref": "#/definitions/failureContext"
        }
      }
    },
    "failureContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failedStage",
        "cause",
        "whatFailed",
        "artifactsAvailable",
        "missingArtifacts",
        "allowedProofLevel",
        "nextFilesOrArtifactsToInspect",
        "recoveryOptions",
        "fallbackPrompt",
        "claimsForbidden"
      ],
      "properties": {
        "failedStage": {
          "type": "string",
          "minLength": 1
        },
        "cause": {
          "type": "string",
          "minLength": 1
        },
        "whatFailed": {
          "type": "string",
          "minLength": 1
        },
        "artifactsAvailable": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/definitions/artifact"
          }
        },
        "missingArtifacts": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowedProofLevel": {
          "type": "string",
          "minLength": 1
        },
        "nextFilesOrArtifactsToInspect": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recoveryOptions": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fallbackPrompt": {
          "type": "string",
          "minLength": 1
        },
        "claimsForbidden": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
