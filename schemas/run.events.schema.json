{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kuzushi.dev/schemas/run.events.schema.json",
  "title": "Kuzushi Run Event",
  "description": "Canonical schema for each JSON line in .kuzushi/runs/<runId>/events.jsonl.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "n",
    "kind",
    "status",
    "message",
    "atUnix"
  ],
  "properties": {
    "n": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "$ref": "#/definitions/eventKind"
    },
    "status": {
      "$ref": "#/definitions/eventStatus"
    },
    "message": {
      "type": "string"
    },
    "atUnix": {
      "type": "integer",
      "minimum": 0
    },
    "tool": {
      "type": "string"
    },
    "artifact": {
      "$ref": "#/definitions/artifact"
    }
  },
  "definitions": {
    "eventKind": {
      "type": "string",
      "enum": [
        "tool"
      ]
    },
    "eventStatus": {
      "type": "string",
      "enum": [
        "started",
        "running",
        "completed",
        "failed",
        "canceled",
        "interrupted",
        "partial",
        "skipped",
        "paused"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "path",
        "kind"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/definitions/artifactKind"
        }
      }
    },
    "artifactKind": {
      "type": "string",
      "enum": [
        "json",
        "jsonl",
        "markdown",
        "sarif",
        "directory",
        "artifact"
      ]
    }
  }
}
