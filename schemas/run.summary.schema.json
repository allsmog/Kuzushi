{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kuzushi.dev/schemas/run.summary.schema.json",
  "title": "Kuzushi Run Summary",
  "description": "Canonical schema for .kuzushi/v3/runs/<runId>/run.json metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "kind",
    "status",
    "target",
    "startedAtUnix"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "$ref": "#/definitions/runKind"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "failed",
        "canceled",
        "interrupted",
        "partial",
        "skipped",
        "paused"
      ]
    },
    "tool": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "startedAtUnix": {
      "type": "integer",
      "minimum": 0
    },
    "completedAtUnix": {
      "type": "integer",
      "minimum": 0
    },
    "findings": {
      "type": "integer",
      "minimum": 0
    },
    "costUsd": {
      "type": "number",
      "minimum": 0
    },
    "observedCostUsd": {
      "type": "number",
      "minimum": 0
    },
    "providerSpendUnresolved": {
      "type": "boolean"
    },
    "error": {
      "type": "string"
    },
    "terminalResultSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "processId": {
      "type": "integer",
      "minimum": 0
    },
    "kuzushiVersion": {
      "type": "string"
    },
    "promptSpineVersion": {
      "type": "string"
    },
    "gitSha": {
      "type": "string"
    },
    "gitBranch": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "configHash": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "houseRules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/houseRuleFingerprint"
      }
    },
    "promptOverrides": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/promptOverrideFingerprint"
      }
    },
    "threatModelSha256": {
      "type": "string"
    },
    "envFingerprint": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/envFingerprint"
      }
    },
    "targetGit": {
      "$ref": "#/definitions/targetGit"
    },
    "llmCalls": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/llmCall"
      }
    },
    "traceMalformedLines": {
      "type": "integer",
      "minimum": 1
    },
    "cliArgs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "loadedModules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/artifact"
      }
    }
  },
  "allOf": [
    {
      "not": {
        "required": [
          "costUsd",
          "observedCostUsd"
        ]
      }
    },
    {
      "if": {
        "required": [
          "observedCostUsd"
        ]
      },
      "then": {
        "required": [
          "providerSpendUnresolved"
        ],
        "properties": {
          "providerSpendUnresolved": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "providerSpendUnresolved"
        ],
        "properties": {
          "providerSpendUnresolved": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "observedCostUsd"
        ]
      }
    }
  ],
  "definitions": {
    "runKind": {
      "type": "string",
      "enum": [
        "run",
        "tool",
        "scan",
        "shell"
      ]
    },
    "llmCallKind": {
      "type": "string",
      "enum": [
        "tool",
        "reasoning",
        "tool-progress",
        "done",
        "refused",
        "plan",
        "llm",
        "critic"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "path",
        "kind"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/definitions/artifactKind"
        }
      }
    },
    "artifactKind": {
      "type": "string",
      "enum": [
        "json",
        "jsonl",
        "markdown",
        "sarif",
        "directory",
        "artifact"
      ]
    },
    "envFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "fingerprint"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        }
      }
    },
    "houseRuleFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "path",
        "sha256"
      ],
      "properties": {
        "module": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      }
    },
    "llmCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n",
        "kind",
        "model",
        "provider",
        "promptHash"
      ],
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/definitions/llmCallKind"
        },
        "verb": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "promptHash": {
          "type": "string"
        },
        "latencyMs": {
          "type": "integer",
          "minimum": 0
        },
        "costUsd": {
          "type": "number",
          "minimum": 0
        },
        "observedCostUsd": {
          "type": "number",
          "minimum": 0
        },
        "providerSpendUnresolved": {
          "type": "boolean"
        },
        "callAttempted": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "not": {
            "required": [
              "costUsd",
              "observedCostUsd"
            ]
          }
        },
        {
          "if": {
            "required": [
              "observedCostUsd"
            ]
          },
          "then": {
            "required": [
              "providerSpendUnresolved"
            ],
            "properties": {
              "providerSpendUnresolved": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "providerSpendUnresolved"
            ],
            "properties": {
              "providerSpendUnresolved": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "observedCostUsd"
            ]
          }
        },
        {
          "if": {
            "required": [
              "callAttempted"
            ],
            "properties": {
              "callAttempted": {
                "const": false
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "costUsd"
                  ]
                },
                {
                  "required": [
                    "observedCostUsd"
                  ]
                },
                {
                  "required": [
                    "providerSpendUnresolved"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "promptOverrideFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "verb",
        "path",
        "sha256"
      ],
      "properties": {
        "module": {
          "type": "string"
        },
        "verb": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      }
    },
    "targetGit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha",
        "dirty"
      ],
      "properties": {
        "sha": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    }
  }
}
