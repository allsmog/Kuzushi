{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kuzushi.dev/schemas/run.trace.schema.json",
  "title": "Kuzushi Run Trace Step",
  "description": "Canonical schema for each JSON line in .kuzushi/runs/<runId>/trace.jsonl.",
  "type": "object",
  "additionalProperties": false,
  "required": ["n", "kind", "label"],
  "properties": {
    "n": { "type": "integer", "minimum": 0 },
    "kind": { "$ref": "#/definitions/traceKind" },
    "label": { "type": "string" },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "latencyMs": { "type": "integer", "minimum": 0 },
    "cost_usd": { "type": "number", "minimum": 0 },
    "costUsd": { "type": "number", "minimum": 0 },
    "module_id": { "type": "string" },
    "moduleId": { "type": "string" },
    "verb": { "type": "string" },
    "parent_step": { "type": "integer", "minimum": 0 },
    "parentStep": { "type": "integer", "minimum": 0 },
    "severity": { "$ref": "#/definitions/traceSeverity" },
    "started_at_ms": { "type": "integer", "minimum": 0 },
    "startedAtMs": { "type": "integer", "minimum": 0 },
    "model": { "type": "string" },
    "provider": { "type": "string" },
    "prompt_hash": { "type": "string" },
    "promptHash": { "type": "string" }
  },
  "definitions": {
    "traceKind": {
      "type": "string",
      "enum": ["tool", "reasoning", "tool-progress", "done", "refused"]
    },
    "traceSeverity": {
      "type": "string",
      "enum": ["info", "warn", "danger"]
    }
  }
}
