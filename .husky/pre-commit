# Kuzushi pre-commit hook
# Keeps hook fast (<5s target). Only formats/lints staged files.
# Escape hatches (see docs/devex/05-conventions-assessment.md):
#   - HUSKY=0 git commit ...       # skip all hooks
#   - git commit --no-verify ...   # skip hooks for this commit
#   - SKIP=<task> git commit ...   # skip a specific lint-staged task

pnpm lint-staged
