{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "src/index.ts",
    "src/public-types.ts",
    "src/contracts.ts",
    "src/schemas.ts",
    "src/utils.ts",
    "src/agent-runtime/types.ts",
    "src/bus/types.ts",
    "src/copilot/print.ts",
    "src/modules/dag-execute.ts",
    "src/modules/dag-ids.ts",
    "src/modules/dag-registry.ts",
    "src/modules/define.ts",
    "src/modules/errors.ts",
    "src/modules/host-handles.ts",
    "src/modules/index.ts",
    "src/modules/loader.ts",
    "src/modules/reference.ts",
    "src/modules/registry.ts",
    "src/modules/schema.ts",
    "src/modules/taint-iris-next/cwe-reference.ts",
    "src/modules/types.ts",
    "src/modules/vendor-assessment/types.ts",
    "src/testing/assertions.ts",
    "src/testing/index.ts",
    "src/testing/module-shape.ts",
    "src/testing/mocks/datastore.ts",
    "src/testing/mocks/event-scope.ts",
    "src/testing/mocks/logger.ts",
    "src/testing/mocks/print-sink.ts",
    "src/testing/mocks/run-artifacts.ts",
    "src/testing/mocks/runtime.ts",
    "src/testing/mocks/ui-store.ts",
    "src/testing/mocks/workspace.ts"
  ],
  "exclude": ["node_modules", "dist", "tests", "src/migrations/_legacy"]
}
