{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Kuzushi whitebox-static demo",
          "informationUri": "https://github.com/allsmog/Kuzushi",
          "rules": [
            { "id": "demo/sql-injection", "name": "Static SQL injection proof" },
            { "id": "demo/sibling-variant", "name": "Sibling SQL variant candidate" },
            { "id": "demo/authz-runtime", "name": "Authorization needs runtime evidence" },
            { "id": "demo/sanitized-sql", "name": "Sanitized SQL false positive" },
            { "id": "demo/scanner-noise", "name": "Misleading scanner noise" }
          ]
        }
      },
      "results": [
        {
          "ruleId": "demo/sql-injection",
          "level": "error",
          "message": {
            "text": "Statically confirmed SQL text construction from req.query.id to db.query."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/routes/users.ts" },
                "region": { "startLine": 5, "endLine": 8 }
              }
            }
          ],
          "properties": {
            "mode": "whitebox-static",
            "staticProofState": "statically_confirmed",
            "rank": 1
          }
        },
        {
          "ruleId": "demo/sibling-variant",
          "level": "warning",
          "message": {
            "text": "Code-cited sibling candidate with the same source-to-sink shape."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/routes/orders.ts" },
                "region": { "startLine": 4, "endLine": 7 }
              }
            }
          ],
          "properties": {
            "mode": "whitebox-static",
            "staticProofState": "code_cited",
            "rank": 2
          }
        },
        {
          "ruleId": "demo/authz-runtime",
          "level": "note",
          "message": {
            "text": "Authorization assessment needs runtime evidence for middleware ordering."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/routes/users.ts" },
                "region": { "startLine": 17, "endLine": 20 }
              }
            }
          ],
          "properties": {
            "mode": "whitebox-static",
            "staticProofState": "needs_runtime_evidence",
            "rank": 3
          }
        },
        {
          "ruleId": "demo/sanitized-sql",
          "level": "none",
          "message": {
            "text": "Statically rejected because integer parsing and parameter binding are visible."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/routes/users.ts" },
                "region": { "startLine": 11, "endLine": 14 }
              }
            }
          ],
          "properties": {
            "mode": "whitebox-static",
            "staticProofState": "statically_rejected",
            "rank": 4
          }
        },
        {
          "ruleId": "demo/scanner-noise",
          "level": "note",
          "message": {
            "text": "Scanner signal only; no source-to-sink proof is present."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/routes/users.ts" },
                "region": { "startLine": 22, "endLine": 23 }
              }
            }
          ],
          "properties": {
            "mode": "whitebox-static",
            "staticProofState": "signal_only",
            "rank": 5
          }
        }
      ]
    }
  ]
}
